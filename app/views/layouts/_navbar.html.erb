<%#
  Barre de navigation, volontairement simple : logo ; visiteur : sections de la page d'accueil et « Se connecter » ;
  utilisateur connecté : accueil, son tableau de bord (et la gestion des utilisateurs pour le super admin), menu
  de compte. Les enquêtes sont mises de côté (routes conservées, plus de lien dans le menu).
%>
<%
  public_links = [["L'outil", root_path(anchor: "outil")], ["Thématiques", root_path(anchor: "thematiques")], ["Pour qui", root_path(anchor: "pour-qui")], ["Tarif", root_path(anchor: "tarif")], ["Contact", contact_path]]
  app_links = []
  if user_signed_in?
    app_links << [current_user.super_admin? ? "Administration" : "Accueil", home_dashboard_path]
    if current_user.territory_type == "epci" && current_user.territory_code.present?
      app_links << ["Mon tableau de bord", epci_dashboard_path]
    elsif current_user.territory_code.present?
      app_links << ["Mon tableau de bord", dashboard_path]
    end
    app_links << ["Utilisateurs", admin_users_path] if current_user.super_admin?
  end
  link_cls = ->(path) { current_page?(path) ? "text-indigo-700 font-semibold" : "text-gray-700 hover:text-indigo-700" }
%>
<nav class="bg-white border-b border-gray-200" data-controller="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 gap-4">
      <a href="<%= root_path %>" class="flex items-center gap-2.5 no-underline">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-600">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"></path><path d="M7 15l4-5 3 3 5-7"></path></svg>
        </span>
        <span class="flex flex-col leading-tight">
          <span class="text-base font-bold text-gray-900">Territory Dashboard</span>
          <span class="text-xs text-gray-500">Observatoire social de territoire</span>
        </span>
      </a>

      <!-- Menu écran large -->
      <div class="hidden md:flex items-center gap-6 text-sm">
        <% if user_signed_in? %>
          <% app_links.each do |label, path| %>
            <a href="<%= path %>" class="<%= link_cls.(path) %>"><%= label %></a>
          <% end %>
          <div class="relative" data-controller="user-menu">
            <button type="button" data-action="click->user-menu#toggle" class="flex items-center gap-2 rounded-full focus:outline-none focus:ring-2 focus:ring-indigo-500" aria-label="Menu du compte">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-indigo-100 text-sm font-medium text-indigo-700"><%= current_user.email[0].upcase %></span>
            </button>
            <div data-user-menu-target="menu" class="hidden absolute right-0 mt-2 w-56 rounded-md bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5 z-30" role="menu">
              <p class="px-4 py-2 text-xs text-gray-500 truncate"><%= current_user.email %></p>
              <div class="border-t border-gray-100"></div>
              <%= button_to "Déconnexion", destroy_user_session_path, method: :delete, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100", role: "menuitem" %>
            </div>
          </div>
        <% else %>
          <% public_links.each do |label, href| %>
            <a href="<%= href %>" class="text-gray-700 hover:text-indigo-700"><%= label %></a>
          <% end %>
          <%= link_to "Se connecter", new_user_session_path, class: "inline-flex items-center min-h-[44px] px-4 rounded-lg border border-indigo-200 text-indigo-700 font-semibold hover:bg-indigo-50" %>
        <% end %>
      </div>

      <!-- Bouton menu mobile -->
      <button type="button" class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" aria-label="Ouvrir le menu" data-action="click->navbar#toggle">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <div data-navbar-target="menu" class="md:hidden hidden border-t border-gray-100 px-4 py-3 space-y-1 bg-white">
    <% if user_signed_in? %>
      <% app_links.each do |label, path| %>
        <a href="<%= path %>" class="block py-2 text-base <%= link_cls.(path) %>"><%= label %></a>
      <% end %>
      <div class="border-t border-gray-100 pt-2 mt-2">
        <p class="py-1 text-sm text-gray-500"><%= current_user.email %></p>
        <%= button_to "Déconnexion", destroy_user_session_path, method: :delete, class: "block w-full text-left py-2 text-base text-gray-700" %>
      </div>
    <% else %>
      <% public_links.each do |label, href| %>
        <a href="<%= href %>" class="block py-2 text-base text-gray-700"><%= label %></a>
      <% end %>
      <%= link_to "Se connecter", new_user_session_path, class: "block py-2 text-base font-semibold text-indigo-700" %>
    <% end %>
  </div>
</nav>
