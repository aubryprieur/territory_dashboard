<%#
  Organisé en questions : 1. présence ou distance des services essentiels 2. densités comparées 3. inventaire.
  Onglet Équipements — dashboard commune (analyse des besoins sociaux).
  Données : INSEE, Base permanente des équipements 2025 (API /equipment/commune/*) : services clés (présence,
  densité pour 10 000 habitants comparée aux territoires de référence, distance au plus proche s'ils sont absents)
  et inventaire des équipements de la commune.
%>
<%
  eq = @equipment_data.is_a?(Hash) && @equipment_data["error"].blank? ? @equipment_data : nil
  # Les services de santé sont présentés dans l'onglet Santé
  services = eq ? eq["services"].reject { |s| s["theme"] == "Santé" } : []
  by_key = services.index_by { |s| s["key"] }
  with_qpv = eq && eq.dig("totals", "count_qpv").to_i.positive?
  ref_names = {
    "epci" => (@epci_code.present? ? epci_display_name : nil), "department" => department_display_name,
    "region" => region_display_name, "france" => "France métropolitaine"
  }
  ref_keys = %w[epci department region france].select { |k| eq && eq.dig("comparison_territories", k) && ref_names[k] }
  density = ->(v) { v.nil? ? "–" : number_with_precision(v, precision: 1) }
  absent = services.select { |s| s["nearest"] }
  questions = [
    ["q-equipment-1", "Quels services essentiels sont présents, et à quelle distance ?"],
    ["q-equipment-2", "La commune est-elle aussi bien équipée que les territoires de comparaison ?"],
    ["q-equipment-3", "Quels équipements la commune compte-t-elle ?"]
  ]
%>
<div class="bg-white shadow rounded-lg p-6 mb-6">
  <h2 class="text-lg font-medium text-gray-900 mb-1">Équipements et services</h2>
  <p class="text-xs text-gray-500 mb-4">Services de petite enfance, pour les personnes âgées, d'accès aux droits, commerces et équipements culturels et sportifs présents dans <%= la_commune %>, selon la Base permanente des équipements de l'INSEE.</p>
  <%= story_summary(questions) %>

</div>

<% if eq.nil? %>
  <div class="bg-white shadow rounded-lg p-6 mb-6"><p class="text-sm text-gray-500">Données sur les équipements indisponibles pour ce territoire.</p></div>
<% else %>
<%= story_card("q-equipment-1", 1, "Quels services essentiels sont présents, et à quelle distance ?",
      "Services de petite enfance, pour les personnes âgées, d'accès aux droits et commerces : présents dans la commune ou distance au plus proche.") do %>
    <section style="margin-bottom:2.5rem">
      <%= indicator_notes("equipment__services_essentiels", years: [eq && eq["year"]]) do %>Pour chaque service : nombre dans <%= la_commune %><%= with_qpv ? " (dont en quartier prioritaire)" : "" %> ou, s'il est absent, distance à vol d'oiseau depuis la mairie jusqu'au plus proche, et commune où il se trouve.<% end %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% services.group_by { |s| s["theme"] }.each do |theme, list| %>
          <div>
            <h4 class="text-sm font-semibold text-gray-700 mb-2"><%= theme %></h4>
            <ul class="text-sm divide-y divide-gray-200">
              <% list.each do |s| %>
                <li class="py-1 flex justify-between gap-4">
                  <span class="text-gray-700"><%= s["label"] %></span>
                  <% if s["count"].to_i.positive? %>
                    <span class="whitespace-nowrap font-medium" style="color:#15803d">✓ <%= fmt_count(s["count"]) %><%= with_qpv && s["count_qpv"].to_i.positive? ? " (#{s['count_qpv']} QPV)" : "" %></span>
                  <% elsif s["nearest"] %>
                    <span class="whitespace-nowrap" style="color:#b45309">✗ <%= number_with_precision(s.dig("nearest", "distance_km"), precision: 1) %> km · <%= s.dig("nearest", "commune_name").to_s.titleize %></span>
                  <% else %>
                    <span class="whitespace-nowrap text-gray-400">✗ absent</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
      <%= indicator_source_note %>
    </section>


  <%# Localisation des commerces et services de proximité (BPE) %>
  <%= render "dashboard/equipment_points_map", group: "shops" %>
<% end %>

<%= story_card("q-equipment-2", 2, "La commune est-elle aussi bien équipée que les territoires de comparaison ?",
      "Nombre de services pour 10 000 habitants, comparé à l'intercommunalité, au département, à la région et à la France.") do %>
    <section style="margin-bottom:2.5rem">
      <%= indicator_notes("equipment__densite_d_equipements", years: [eq && eq["year"]]) do %>Nombre pour 10 000 habitants (population <%= eq["population_year"] %>). En rouge, une densité inférieure à celle de la France métropolitaine. Les professionnels et services de santé sont présentés dans l'onglet Santé.<% end %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="text-left text-xs text-gray-500 border-b">
              <th class="py-2 pr-4 font-medium">Service</th>
              <th class="py-2 pr-4 font-medium text-right">Nombre</th>
              <th class="py-2 pr-4 font-medium text-right"><%= @territory_name %></th>
              <% ref_keys.each do |k| %><th class="py-2 pr-4 font-medium text-right"><%= display_territory_name(ref_names[k]) %></th><% end %>
            </tr>
          </thead>
          <tbody>
            <% services.select { |s| s["density_compared"] }.each do |s| %>
              <% fr = s.dig("comparison", "france") %>
              <tr class="border-b border-gray-100">
                <td class="py-2 pr-4 text-gray-800"><%= s["label"] %></td>
                <td class="py-2 pr-4 text-right text-gray-600"><%= fmt_count(s["count"]) %></td>
                <td class="py-2 pr-4 text-right font-semibold" style="<%= fr && s['density'] && s['density'] < fr ? 'color:#b91c1c' : '' %>"><%= density.(s["density"]) %></td>
                <% ref_keys.each do |k| %><td class="py-2 pr-4 text-right text-gray-600"><%= density.(s.dig("comparison", k)) %></td><% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= indicator_source_note %>
    </section>
    <% if @epci_mode %>
      <%# Tableau de bord EPCI : densité de chaque service par commune %>
      <%= render "dashboard/map_group", maps: services.select { |s| s["density_compared"] }.map { |s|
            { kind: :communes, map: epci_equipment_density_map(s), definition: "#{s['label']} : nombre pour 10 000 habitants dans chaque commune." } } %>
    <% end %>

<% end %>

<%= story_card("q-equipment-3", 3, "Quels équipements la commune compte-t-elle ?",
      "Tous les équipements recensés par l'INSEE dans la commune, par domaine.") do %>
    <section style="margin-bottom:1.5rem">
      <%= indicator_notes("equipment__inventaire", years: [eq && eq["year"]]) do %>Tous les équipements recensés, par domaine. Cliquer sur un domaine pour le détail.<% end %>
      <% eq["inventory"].each do |dom| %>
        <details class="mb-2 border border-gray-200 rounded-lg">
          <summary class="cursor-pointer px-4 py-2 text-sm font-medium text-gray-800 flex justify-between">
            <span><%= dom["label"] %></span>
            <span class="text-gray-500"><%= fmt_count(dom["count"]) %><%= with_qpv && dom["count_qpv"].to_i.positive? ? " · #{dom['count_qpv']} en QPV" : "" %></span>
          </summary>
          <div class="px-4 pb-3 grid grid-cols-1 md:grid-cols-2 gap-4">
            <% dom["subdomains"].each do |sub| %>
              <div>
                <h5 class="text-xs font-semibold text-gray-600 uppercase tracking-wide mt-2 mb-1"><%= sub["label"] %></h5>
                <ul class="text-sm">
                  <% sub["items"].sort_by { |i| -i["count"].to_i }.each do |i| %>
                    <li class="flex justify-between gap-4 py-0.5">
                      <span class="text-gray-700"><%= i["label"] %></span>
                      <span class="text-gray-900 font-medium"><%= i["count"] %><%= with_qpv && i["count_qpv"].to_i.positive? ? " (#{i['count_qpv']} QPV)" : "" %></span>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
      <%= indicator_source_note %>
    </section>

    <div class="pt-4 border-t border-gray-200 text-xs text-gray-500 space-y-1">
      <p>Source : <%= eq["source"] %>. Quartiers prioritaires de la politique de la ville : géographie 2024.</p>
      <p>Distances à vol d'oiseau depuis la mairie de la commune : les temps de trajet réels peuvent être nettement plus longs.</p>
    </div>
<% end %>

<% end %>
