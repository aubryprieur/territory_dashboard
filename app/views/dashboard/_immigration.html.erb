<%#
  Organisé en questions : 1. part et localisation des immigrés et étrangers 2. accès à l'emploi.
  Onglet Immigrés et étrangers — dashboard commune (analyse des besoins sociaux).
  Données : INSEE, recensement 2023 (API /immigration/*), un seul millésime.
%>
<%
  territories = comparison_territories("immigration_data", {
    commune: @immigration_data, epci: @epci_immigration_data, department: @department_immigration_data,
    region: @region_immigration_data, france: @france_immigration_data
  })
  commune = territories.find { |t| t[:main] }
  france = territories.find { |t| t[:key] == :france }
  year = commune && comparison_latest_year(commune[:data], comparison_years(commune[:data], "immigration_data"))
  v = ->(t, key) { t && territory_value(t, year, key) }
  questions = [
    ["q-immigration-1", "Combien d'immigrés et d'étrangers vivent dans la commune, et dans quels quartiers ?"],
    ["q-immigration-2", "Les immigrés accèdent-ils autant à l'emploi que les autres habitants ?"]
  ]
%>
<div class="bg-white shadow rounded-lg p-6 mb-6">
  <h2 class="text-lg font-medium text-gray-900 mb-1">Immigrés et étrangers</h2>
  <p class="text-xs text-gray-500 mb-4">Un immigré est une personne née étrangère à l'étranger et résidant en France ; une partie des immigrés est devenue française. Un étranger est une personne qui n'a pas la nationalité française ; une partie des étrangers est née en France. Deux questions.</p>
  <%= story_summary(questions) %>

  <%= render "dashboard/fragility_ranks", tab: "immigration" %>
  <%= story_takeaways("immigration") %>
  <% if commune %>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="bg-indigo-50 p-4 rounded-lg">
        <h4 class="text-xs font-medium text-indigo-800">Immigrés (<%= year %>)</h4>
        <p class="text-2xl font-bold text-indigo-900"><%= fmt_pct(v.(commune, "immigrant_rate")) %></p>
        <p class="text-xs text-gray-600"><%= fmt_count(v.(commune, "imm")) %> personnes<%= small_count_flag(v.(commune, "imm")) %> · France métropolitaine <%= fmt_pct(v.(france, "immigrant_rate")) %></p>
      </div>
      <div class="bg-purple-50 p-4 rounded-lg">
        <h4 class="text-xs font-medium text-purple-800">Étrangers (<%= year %>)</h4>
        <p class="text-2xl font-bold text-purple-900"><%= fmt_pct(v.(commune, "foreigner_rate")) %></p>
        <p class="text-xs text-gray-600"><%= fmt_count(v.(commune, "foreign")) %> personnes<%= small_count_flag(v.(commune, "foreign")) %> · France métropolitaine <%= fmt_pct(v.(france, "foreigner_rate")) %></p>
      </div>
      <div class="bg-red-50 p-4 rounded-lg">
        <h4 class="text-xs font-medium text-red-800">Chômage des immigrés</h4>
        <p class="text-2xl font-bold text-red-900"><%= fmt_pct(v.(commune, "imm_unemployment_rate")) %></p>
        <p class="text-xs text-gray-600">non-immigrés : <%= fmt_pct(v.(commune, "nonimm_unemployment_rate")) %> · actifs de 15 ans ou plus<%= small_count_flag(v.(commune, "imm_employed_15p").to_f + v.(commune, "imm_unemployed_15p").to_f) %></p>
      </div>
      <div class="bg-orange-50 p-4 rounded-lg">
        <h4 class="text-xs font-medium text-orange-800">Emploi des femmes immigrées de 25-54 ans</h4>
        <p class="text-2xl font-bold text-orange-900"><%= fmt_pct(v.(commune, "imm_women_employment_rate_25_54")) %></p>
        <p class="text-xs text-gray-600">non-immigrées : <%= fmt_pct(v.(commune, "nonimm_women_employment_rate_25_54")) %> · au foyer : <%= fmt_pct(v.(commune, "imm_women_homemakers_rate_25_54")) %><%= small_count_flag(v.(commune, "imm_women_25_54")) %></p>
      </div>
    </div>
  <% end %>
</div>

<% if commune.nil? %>
  <div class="bg-white shadow rounded-lg p-6 mb-6"><p class="text-sm text-gray-500">Données sur les immigrés et les étrangers indisponibles pour ce territoire.</p></div>
<% else %>
  <%= story_card("q-immigration-1", 1, "Combien d'immigrés et d'étrangers vivent dans la commune, et dans quels quartiers ?",
        "Part des immigrés et des étrangers dans la population, comparée aux autres territoires, et répartition par quartier.") do %>
    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Comparaison territoriale (<%= year %>)</h3>
      <%= indicator_notes("immigration__comparaison_territoriale", years: [year]) do %>Chômage au sens du recensement (personnes se déclarant au chômage), parmi les actifs de 15 ans ou plus. Ouvriers et employés : parmi les personnes de 15 ans ou plus ayant une profession ou en ayant eu une.<% end %>
      <div class="overflow-x-auto mb-6">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="text-left text-xs text-gray-500 border-b">
              <th class="py-2 pr-4 font-medium">Territoire</th>
              <th class="py-2 pr-4 font-medium text-right">Immigrés</th>
              <th class="py-2 pr-4 font-medium text-right">Étrangers</th>
              <th class="py-2 pr-4 font-medium text-right">Immigrés parmi les 55 ans ou +</th>
              <th class="py-2 pr-4 font-medium text-right">Chômage immigrés</th>
              <th class="py-2 pr-4 font-medium text-right">Chômage non-immigrés</th>
              <th class="py-2 pr-4 font-medium text-right">Emploi femmes immigrées 25-54 ans</th>
              <th class="py-2 font-medium text-right">Ouvriers et employés parmi les immigrés</th>
            </tr>
          </thead>
          <tbody>
            <% territories.each do |t| %>
              <tr class="border-b border-gray-100 <%= t[:main] ? 'font-semibold' : '' %>">
                <td class="py-2 pr-4"><%= territory_dot(t) %><%= t[:name] %></td>
                <td class="py-2 pr-4 text-right"><%= fmt_pct(v.(t, "immigrant_rate")) %></td>
                <td class="py-2 pr-4 text-right"><%= fmt_pct(v.(t, "foreigner_rate")) %></td>
                <td class="py-2 pr-4 text-right"><%= fmt_pct(v.(t, "immigrant_share_ge55")) %></td>
                <td class="py-2 pr-4 text-right"><%= fmt_pct(v.(t, "imm_unemployment_rate")) %></td>
                <td class="py-2 pr-4 text-right"><%= fmt_pct(v.(t, "nonimm_unemployment_rate")) %></td>
                <td class="py-2 pr-4 text-right"><%= fmt_pct(v.(t, "imm_women_employment_rate_25_54")) %></td>
                <td class="py-2 text-right"><%= fmt_pct(v.(t, "imm_workers_employees_share")) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= comparison_grouped_bar_chart(territories, year, [
            ["immigrant_rate", "Part d'immigrés"], ["foreigner_rate", "Part d'étrangers"],
            ["immigrant_share_ge55", "Immigrés parmi les 55 ans ou +"]
          ], "Part des immigrés et des étrangers par territoire", height: 240) %>
      <%= indicator_source_note %>
    </section>
    <% if @epci_mode %>
      <%# Tableau de bord EPCI : immigrés et étrangers par commune %>
      <%= render "dashboard/map_group", maps: [
          { kind: :communes, map: epci_indicator_map(territories, "immigrant_rate", title: "Part d'immigrés", value_format: :pct, years: [year]),
            definition: "Personnes nées étrangères à l'étranger et résidant en France, en % de la population." },
          { kind: :communes, map: epci_indicator_map(territories, "foreigner_rate", title: "Part d'étrangers", value_format: :pct, years: [year]),
            definition: "Personnes de nationalité étrangère, en % de la population." }
        ] %>
    <% end %>

    <%= render "dashboard/map_group", maps: [
        { kind: :iris, map: cached_iris_map("immigrant_share"),
          definition: "Personnes nées étrangères à l'étranger et résidant en France, en % de la population de l'IRIS.",
          commune_latest: { year: year, value: v.(commune, "immigrant_rate"), count: v.(commune, "imm"), total: nil } },
        { kind: :iris, map: cached_iris_map("foreigner_share"),
          definition: "Personnes de nationalité étrangère, en % de la population de l'IRIS." }
      ] %>

    <div class="text-xs text-gray-500 border-t pt-3 mt-4" style="border-color:#e5e7eb">
      <p>Source : INSEE, recensement de la population 2023 (exploitation principale ; catégories socioprofessionnelles : exploitation complémentaire). Effectifs estimés à partir d'enquêtes annuelles : ⚠ à interpréter avec prudence en dessous de 200 personnes.</p>
    </div>
  <% end %>

  <%= story_card("q-immigration-2", 2, "Les immigrés accèdent-ils autant à l'emploi que les autres habitants ?",
        "Chômage, emploi des femmes et catégories sociales des immigrés comparés à ceux des non-immigrés.") do %>
    <section style="margin-bottom:1.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Immigrés et non-immigrés face à l'emploi (<%= year %>)</h3>
      <%= indicator_notes("immigration__immigres_et_non_immigres_face_a_l_emploi", years: [year]) do %>Comparaison des immigrés et des non-immigrés de <%= la_commune %>, avec la France métropolitaine en repère (couleurs claires).<% end %>
      <%= immigration_gap_chart(commune, france, year) %>
      <%= indicator_source_note %>
    </section>
    <% if @epci_mode %>
      <%# Tableau de bord EPCI : emploi des immigrés par commune %>
      <%= render "dashboard/map_group", maps: [
          { kind: :communes, map: epci_indicator_map(territories, "imm_unemployment_rate", title: "Chômage des immigrés", value_format: :pct, years: [year]),
            definition: "Chômeurs parmi les actifs immigrés de 15 ans ou plus, au sens du recensement, en %." },
          { kind: :communes, map: epci_indicator_map(territories, "imm_women_employment_rate_25_54", title: "Emploi des femmes immigrées de 25-54 ans", value_format: :pct, years: [year]),
            definition: "Femmes immigrées de 25 à 54 ans en emploi, en %." }
        ] %>
    <% end %>

    <div class="text-xs text-gray-500 border-t pt-3 mt-4" style="border-color:#e5e7eb">
      <p>Source : INSEE, recensement de la population 2023 (exploitation principale ; catégories socioprofessionnelles : exploitation complémentaire). Effectifs estimés à partir d'enquêtes annuelles : ⚠ à interpréter avec prudence en dessous de 200 personnes.</p>
    </div>
  <% end %>
<% end %>
