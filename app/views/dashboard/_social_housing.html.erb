<%#
  Parc locatif social — SDES, RPLS au 1er janvier (API /social-housing/*) : évolution du parc depuis 2013,
  mobilité et vacance, loyer moyen, structure du parc en 2025. Rendu à la suite de l'onglet Logement.
%>
<%
  sh_territories = comparison_territories("social_housing_data", {
    commune: @social_housing_data, epci: @epci_social_housing_data, department: @department_social_housing_data,
    region: @region_social_housing_data, france: @france_social_housing_data
  })
  sh_commune = sh_territories.find { |t| t[:key] == :commune }
%>
<div class="bg-white shadow rounded-lg p-6 mb-6">
  <h2 class="text-lg font-medium text-gray-900 mb-1">Parc locatif social</h2>
  <p class="text-xs text-gray-500 mb-4">Logements appartenant aux bailleurs sociaux (offices publics de l'habitat, entreprises sociales pour l'habitat, logements conventionnés des SEM), au 1er janvier de chaque année, d'après le répertoire des bailleurs (RPLS).</p>

  <% if sh_commune.nil? %>
    <p class="text-sm text-gray-500">Aucun logement social recensé dans la commune au 1er janvier 2025.</p>
  <% else %>
    <%
      sh_years = comparison_years(@social_housing_data, "social_housing_data")
      sh_latest = comparison_latest_year(@social_housing_data, sh_years)
      sh_comparison = comparison_start_year(@social_housing_data, sh_years)
      sh_first = sh_years.first
      sh_common = { territories: sh_territories, years: sh_years, latest: sh_latest, comparison: sh_comparison,
                    table_years: [sh_first, sh_comparison, sh_latest].uniq }
      sv = ->(key) { territory_value(sh_commune, sh_latest, key) }
    %>

    <%= render "dashboard/territory_indicator", **sh_common.merge(comparison: sh_first),
          title: "Évolution du parc social depuis #{sh_first}", theme: "amber",
          value_key: "social_dwellings_index", value_format: :decimal, unit: "", decimals: 1,
          count_key: "social_dwellings", count_label: "logements sociaux",
          definition: "Indice base 100 en #{sh_first} : nombre de logements sociaux rapporté à celui de #{sh_first}. 110 signifie que le parc a augmenté de 10 % (constructions, acquisitions), 95 qu'il a diminué de 5 % (ventes, démolitions).",
          details: [
            { label: "Logements sociaux pour 100 résidences principales", share_key: "density" },
            { label: "Situés en quartier prioritaire (QPV)", share_key: "qpv_share" }
          ] %>

    <%= render "dashboard/territory_indicator", **sh_common,
          title: "Taux de mobilité dans le parc social", theme: "amber",
          value_key: "mobility_rate",
          definition: "Part des logements proposés à la location depuis au moins un an dont le locataire a changé dans l'année (emménagements). Un taux faible signifie peu de logements libérés chaque année, donc une attente plus longue pour les demandeurs.",
          details: [
            { label: "Taux de vacance", share_key: "vacancy_rate" },
            { label: "Vacance de plus de 3 mois", share_key: "vacancy_3m_rate" }
          ] %>

    <%= render "dashboard/territory_indicator", **sh_common,
          title: "Loyer moyen du parc social", theme: "amber",
          value_key: "avg_rent_m2", value_format: :decimal, unit: "€/m²", decimals: 2,
          definition: "Loyer moyen hors charges par m² de surface habitable des logements loués au 1er janvier, en euros courants." %>

    <%
      rows = [
        ["density", "Logements sociaux pour 100 résidences principales", :pct],
        ["qpv_share", "Situés en quartier prioritaire (QPV)", :pct],
        ["individual_share", "Logements individuels (maisons)", :pct],
        ["small_share", "Petits logements (1 ou 2 pièces)", :pct],
        ["large_share", "Grands logements (5 pièces ou plus)", :pct],
        ["plai_share", "Financés en PLAI (loyers très sociaux)", :pct],
        ["intermediate_share", "Financés en PLS ou PLI (loyers intermédiaires)", :pct],
        ["recent_share", "Construits il y a moins de 10 ans", :pct],
        ["old_share", "Construits il y a 60 ans ou plus", :pct],
        ["avg_age", "Âge moyen du parc (ans)", :decimal],
        ["dpe_fg_share", "Étiquette énergie F ou G (parmi les DPE réalisés)", :pct],
        ["dpe_ab_share", "Étiquette énergie A ou B (parmi les DPE réalisés)", :pct]
      ]
    %>
    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Caractéristiques du parc social (<%= sh_latest %>)</h3>
      <p class="text-xs text-gray-500 mb-4">
        En % du parc, sauf mention.
        <% sold, demolished, new_ls = sv.("sold"), sv.("demolished"), sv.("new_dwellings") %>
        À <%= sh_commune[:name] %> : <%= fmt_count(new_ls || 0) %> logement(s) mis en service, <%= fmt_count(sold || 0) %> vendu(s) et <%= fmt_count(demolished || 0) %> démoli(s) dans l'année précédant le <%= "1er janvier #{sh_latest}" %>.
      </p>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Indicateur</th>
              <% sh_territories.each do |t| %>
                <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t[:name] %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% rows.each do |key, label, fmt| %>
              <tr>
                <td class="px-4 py-2 text-sm text-gray-900"><%= label %></td>
                <% sh_territories.each do |t| %>
                  <% v = territory_value(t, sh_latest, key) %>
                  <td class="px-3 py-2 whitespace-nowrap text-sm text-right <%= t[:key] == :commune ? 'font-semibold text-gray-900' : 'text-gray-600' %>">
                    <%= fmt == :pct ? fmt_pct(v) : fmt_decimal(v, precision: 0) %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="pt-4 border-t border-gray-200 text-xs text-gray-500 space-y-1">
      <p>Source : SDES, répertoire des logements locatifs des bailleurs sociaux (RPLS) au 1er janvier <%= sh_latest %>, données soumises au secret statistique. Paris, Lyon, Marseille et EPCI situés sur plusieurs départements : taux pondérés par le nombre de logements.</p>
      <p>PLAI : prêt locatif aidé d'intégration (ménages les plus modestes) ; PLUS : prêt locatif à usage social (logement social classique) ; PLS, PLI : loyers intermédiaires. Le recensement (« Locataires HLM », ci-dessus) mesure les ménages, le RPLS les logements.</p>
    </div>
  <% end %>
</div>
