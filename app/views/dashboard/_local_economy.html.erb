<%#
  Organisé en questions : 1. emplois et secteurs 2. établissements employeurs (_economic_fabric) 3. créations d'entreprises (_business_creations).
  Onglet Tissu économique — dashboard commune (analyse des besoins sociaux).
  Emplois situés sur le territoire (INSEE RP 2012, 2017, 2023 — API /employment-activity/*) et tissu
  d'établissements employeurs (INSEE Flores 2017 et 2021 — API /economic-fabric/*, partial _economic_fabric).
%>
<%
  territories = comparison_territories("employment_data", {
    commune: @emp_data, epci: @epci_emp_data, department: @department_emp_data,
    region: @region_emp_data, france: @france_emp_data
  })
  years = comparison_years(@emp_data, "employment_data")
  latest = comparison_latest_year(@emp_data, years)
  comparison = comparison_start_year(@emp_data, years)
  commune = territories.first
  common = { territories: territories, years: years, latest: latest, comparison: comparison }
  questions = [
    ["q-economy-1", "Combien d'emplois la commune offre-t-elle, et dans quels secteurs ?"],
    ["q-economy-2", "Quels établissements emploient sur le territoire ?"],
    ["q-economy-3", "Crée-t-on des entreprises dans la commune ?"]
  ]
%>
<div class="bg-white shadow rounded-lg p-6 mb-6">
  <h2 class="text-lg font-medium text-gray-900 mb-1">Tissu économique</h2>
  <p class="text-xs text-gray-500 mb-4">Emplois et entreprises implantés sur le territoire, quel que soit le lieu de résidence des personnes qui y travaillent : poids de l'emploi local, secteurs d'activité, taille des établissements, activités tournées vers les habitants.</p>
  <%= story_summary(questions) %>

  <%= render "dashboard/fragility_ranks", tab: "local_economy" %>
  <%= story_takeaways("local_economy") %>
</div>

<% if commune.nil? || !commune[:main] %>
  <div class="bg-white shadow rounded-lg p-6 mb-6"><p class="text-sm text-gray-500">Données sur l'emploi local indisponibles pour ce territoire.</p></div>
<% else %>
  <%= story_card("q-economy-1", 1, "Combien d'emplois la commune offre-t-elle, et dans quels secteurs ?",
        "Emplois situés sur le territoire, quel que soit le lieu de résidence des personnes qui les occupent : poids de l'emploi local, secteurs d'activité, économie sociale et solidaire.") do %>
    <%= render "dashboard/territory_indicator", **common,
          title: "Concentration d'emploi : emplois pour 100 actifs occupés", theme: "teal",
          value_key: "employment_concentration", value_format: :decimal, unit: "", decimals: 1,
          count_key: "jobs", count_label: "emplois sur le territoire",
          definition: "Nombre d'emplois sur le territoire pour 100 actifs occupés qui y résident. Au-dessous de 100, le territoire est plutôt résidentiel : une partie des habitants travaille ailleurs.",
          details: [
            { label: "Emplois salariés", share_key: "salaried_percentage" },
            { label: "Salariés à temps partiel", share_key: "part_time_salaried_percentage" },
            { label: "Emplois occupés par des femmes", share_key: "women_jobs_percentage" }
          ] %>

    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Emplois selon le secteur d'activité (<%= latest %>)</h3>
      <p class="text-xs text-gray-500 mb-4">Emplois au lieu de travail, en %.</p>
      <%= comparison_stacked_chart(territories, latest, [
            ["jobs_agriculture_percentage", "Agriculture", "#84cc16"],
            ["jobs_industry_percentage", "Industrie", "#1e3a8a"],
            ["jobs_construction_percentage", "Construction", "#f59e0b"],
            ["jobs_trade_services_percentage", "Commerce, transports, services", "#93c5fd"],
            ["jobs_public_services_percentage", "Adm. publique, enseignement, santé, social", "#0d9488"]
          ], "Emplois par secteur et par territoire") %>
    </section>

    <%= render "dashboard/sdg_indicator", key: "ess_jobs_share", theme: "green",
          title: "Emplois de l'économie sociale et solidaire",
          definition: "Part des emplois salariés du territoire dans les associations, coopératives, mutuelles et fondations. Repère du tissu associatif et des acteurs de l'action sociale." %>

    <div class="pt-4 border-t border-gray-200 text-xs text-gray-500 space-y-1">
      <p>Source : INSEE, recensements de la population <%= years.join(", ") %> (emplois au lieu de travail) ; économie sociale et solidaire : INSEE / SDES, indicateurs territoriaux de développement durable.</p>
    </div>
  <% end %>

  <%= story_card("q-economy-2", 2, "Quels établissements emploient sur le territoire ?") do %>
    <%= render "dashboard/economic_fabric" %>
  <% end %>

  <%= story_card("q-economy-3", 3, "Crée-t-on des entreprises dans la commune ?") do %>
    <%= render "dashboard/business_creations" %>

    <div class="pt-4 border-t border-gray-200 text-xs text-gray-500 space-y-1">
      <p>Sources : INSEE, recensements de la population <%= years.join(", ") %> (emplois au lieu de travail) ; INSEE, Flores (établissements et postes salariés) ; INSEE, SIDE (créations d'entreprises) ; économie sociale et solidaire : INSEE / SDES, indicateurs territoriaux de développement durable.</p>
    </div>
  <% end %>
<% end %>
