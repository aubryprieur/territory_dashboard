<%#
  Pratique sportive — licences sportives 2023 (INJEP — MEOS, diffusion Observatoire des territoires, API /sports/*).
  Licences comptées à la commune de résidence du licencié. Rendu dans les onglets Vie locale et Seniors.
  locals (optionnels) : only (liste de clés à afficher), title, intro
%>
<%
  only ||= nil
  title ||= nil
  intro ||= nil
  sp_territories = comparison_territories("sports_data", {
    commune: @sports_data, epci: @epci_sports_data, department: @department_sports_data,
    region: @region_sports_data, france: @france_sports_data
  })
  sp_commune = sp_territories.find { |t| t[:main] }
  sp_france = sp_territories.find { |t| t[:key] == :france }
%>
<% if sp_commune %>
  <% sp_year = comparison_latest_year(@sports_data, comparison_years(@sports_data, "sports_data")) %>
  <%
    rows = [
      ["licence_rate", "Licenciés pour 100 habitants", :rate],
      ["licence_rate_0_14", "Licenciés de moins de 15 ans pour 100 enfants de moins de 15 ans", :rate],
      ["licence_rate_15_29", "Licenciés de 15-29 ans pour 100 jeunes de 15-29 ans", :rate],
      ["licence_rate_30_59", "Licenciés de 30-59 ans pour 100 habitants de 30-59 ans", :rate],
      ["licence_rate_60p", "Licenciés de 60 ans ou plus pour 100 habitants de 60 ans ou plus", :rate],
      ["girls_share_0_14", "Part des filles parmi les licenciés de moins de 15 ans", :share],
      ["women_share_15_29", "Part des femmes parmi les licenciés de 15-29 ans", :share],
      ["women_share_30_59", "Part des femmes parmi les licenciés de 30-59 ans", :share],
      ["women_share_60p", "Part des femmes parmi les licenciés de 60 ans ou plus", :share]
    ]
    rows = rows.select { |r| only.include?(r[0]) } if only
  %>
  <section style="margin-bottom:2.5rem">
    <h3 class="text-base font-medium text-gray-900 mb-1"><%= title || "Pratique sportive en club" %> (<%= sp_year %>)</h3>
    <% if intro.present? %><p class="text-xs text-gray-500 mb-2"><%= intro %></p><% end %>
    <%= indicator_notes("sports__bloc", years: [sp_year]) do %>Licences délivrées par les fédérations sportives, comptées dans la commune de résidence du licencié. En rouge, une valeur inférieure à la France métropolitaine. Les taux comptent des licences et non des personnes : un même habitant peut détenir plusieurs licences (plusieurs clubs, sport scolaire), le taux peut donc dépasser 100. Dans les petites communes, quelques licences ou un écart entre les sources (licences rattachées à la commune de résidence déclarée au club, population issue du recensement) suffisent à faire varier fortement le taux : à lire comme un ordre de grandeur.<% end %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Indicateur</th>
            <% sp_territories.each do |t| %>
              <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t[:name] %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% rows.each do |key, label, kind| %>
            <% fr = sp_france && territory_value(sp_france, sp_year, key) %>
            <tr>
              <td class="px-4 py-2 text-sm text-gray-900"><%= label %></td>
              <% sp_territories.each do |t| %>
                <% v = territory_value(t, sp_year, key) %>
                <% low = t[:main] && fr && v && v < fr %>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-right <%= t[:main] ? 'font-semibold' : 'text-gray-600' %>" style="<%= low ? 'color:#b91c1c' : '' %>">
                  <%= v.nil? ? "–" : (kind == :share ? fmt_pct(v) : number_with_precision(v, precision: 1, separator: ",")) %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= indicator_source_note do %>INJEP — MEOS, recensement des licences et clubs sportifs <%= sp_year %> (Observatoire des territoires). France : valeurs nationales publiées par l'Observatoire des territoires.<% end %>
    <% if @epci_mode %>
      <%# Tableau de bord EPCI : taux de licences par commune %>
      <%= render "dashboard/map_group", maps: rows.select { |r| r[2] == :rate }.map { |key, label, _|
            { kind: :communes, map: epci_indicator_map(sp_territories, key, title: label, value_format: :decimal, years: [sp_year],
                                                       source: "INJEP — MEOS, recensement des licences sportives #{sp_year}"),
              definition: "#{label}. Un même habitant peut détenir plusieurs licences : le taux peut dépasser 100." } } %>
    <% end %>
  </section>
<% end %>
