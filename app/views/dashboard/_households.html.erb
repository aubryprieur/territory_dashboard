<%#
  Onglet Ménages — dashboard commune (analyse des besoins sociaux).
  Données : INSEE, recensements de la population 2012, 2017, 2023 (valeurs officielles
  par territoire, via l'API /households/*).
%>
<%
  territories = comparison_territories("household_data", {
    commune: @household_data, epci: @epci_household_data, department: @department_household_data,
    region: @region_household_data, france: @france_household_data
  })
  years = comparison_years(@household_data, "household_data")
  latest = comparison_latest_year(@household_data, years)
  comparison = comparison_start_year(@household_data, years)
  commune = territories.first
  common = { territories: territories, years: years, latest: latest, comparison: comparison }
%>
<div class="bg-white shadow rounded-lg p-6 mb-6">
  <h2 class="text-lg font-medium text-gray-900 mb-4">Ménages</h2>

  <% if commune.nil? || commune[:key] != :commune %>
    <p class="text-sm text-gray-500">Données ménages indisponibles pour ce territoire.</p>
  <% else %>
    <% hv = ->(key, year = latest) { territory_value(commune, year, key) } %>

    <!-- Synthèse -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
      <div class="bg-teal-50 p-4 rounded-lg">
        <h3 class="text-sm font-medium text-teal-800 mb-1">Ménages</h3>
        <p class="text-2xl font-bold text-teal-900"><%= fmt_count(hv.("households")) %></p>
        <p class="text-xs text-teal-700">
          <% h0 = hv.("households", comparison); h1 = hv.("households") %>
          <% if h0 && h1 && h0.positive? %><%= (h1 >= h0 ? "+" : "−") + number_with_precision(((h1 - h0) / h0 * 100).abs, precision: 1) %> % depuis <%= comparison %><% end %>
        </p>
      </div>
      <div class="bg-indigo-50 p-4 rounded-lg">
        <h3 class="text-sm font-medium text-indigo-800 mb-1">Taille moyenne</h3>
        <p class="text-2xl font-bold text-indigo-900"><%= fmt_decimal(hv.("average_household_size")) %> pers.</p>
        <p class="text-xs text-indigo-700">par ménage en <%= latest %></p>
      </div>
      <div class="bg-purple-50 p-4 rounded-lg">
        <h3 class="text-sm font-medium text-purple-800 mb-1">Ménages d'une personne</h3>
        <p class="text-2xl font-bold text-purple-900"><%= fmt_pct(hv.("one_person_percentage")) %></p>
        <p class="text-xs text-purple-700"><%= fmt_count(hv.("one_person")) %> ménages</p>
      </div>
      <div class="bg-blue-50 p-4 rounded-lg">
        <h3 class="text-sm font-medium text-blue-800 mb-1">80 ans ou plus vivant seuls</h3>
        <p class="text-2xl font-bold text-blue-900"><%= fmt_pct(hv.("living_alone_rate_80_plus")) %></p>
        <p class="text-xs text-blue-700"><%= fmt_count(hv.("living_alone_80_plus")) %> personnes<%= small_count_flag(hv.("living_alone_80_plus")) %></p>
      </div>
    </div>

    <!-- 1. Taille des ménages -->
    <%= render "dashboard/territory_indicator", **common,
          title: "Taille moyenne des ménages", theme: "indigo",
          value_key: "average_household_size", value_format: :decimal, unit: "pers.",
          count_key: "households", count_label: "ménages",
          definition: "Nombre moyen de personnes par ménage (population des ménages / nombre de ménages). Une baisse traduit le vieillissement, les séparations et la progression des personnes seules." %>

    <!-- 2. Composition des ménages -->
    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Composition des ménages (<%= latest %>)</h3>
      <p class="text-xs text-gray-500 mb-4">Répartition des ménages selon leur type, en %. Un ménage = l'ensemble des personnes partageant un même logement.</p>
      <%
        composition = [
          ["one_person_percentage", "Personnes seules", "#a78bfa"],
          ["other_without_family_percentage", "Autres ménages sans famille", "#d1d5db"],
          ["couple_without_children_percentage", "Couples sans enfant", "#93c5fd"],
          ["couple_with_children_percentage", "Couples avec enfant(s)", "#3b82f6"],
          ["single_parent_percentage", "Familles monoparentales", "#1e3a8a"]
        ]
      %>
      <%= comparison_stacked_chart(territories, latest, composition, "Composition des ménages par territoire") %>

      <div class="overflow-x-auto mt-6">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= @territory_name %></th>
              <% years.each do |y| %>
                <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= y %></th>
              <% end %>
              <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= comparison %>→<%= latest %></th>
              <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">France métro. <%= latest %></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% france = territories.find { |t| t[:key] == :france } %>
            <% (composition.first(1) + [["women_alone_percentage", "dont femmes seules"], ["men_alone_percentage", "dont hommes seuls"]] + composition.drop(1)).each do |key, label, _| %>
              <% sub = label.start_with?("dont") %>
              <tr>
                <td class="px-4 py-2 whitespace-nowrap text-sm <%= sub ? 'text-gray-500' : 'text-gray-900' %>" style="<%= sub ? 'padding-left:2rem' : '' %>"><%= label %></td>
                <% years.each do |y| %>
                  <td class="px-3 py-2 whitespace-nowrap text-sm text-right <%= y == latest ? 'font-semibold text-gray-900' : 'text-gray-600' %>"><%= fmt_pct(hv.(key, y)) %></td>
                <% end %>
                <td class="px-3 py-2 whitespace-nowrap text-right"><%= fmt_trend(hv.(key, comparison), hv.(key)) %></td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-right text-gray-600"><%= france ? fmt_pct(territory_value(france, latest, key)) : "–" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 3. Personnes vivant seules -->
    <%= render "dashboard/territory_indicator", **common,
          title: "Personnes de 65 ans ou plus vivant seules", theme: "blue",
          value_key: "living_alone_rate_65_plus",
          count_key: "living_alone_65_plus", count_label: "personnes de 65 ans ou plus vivant seules",
          definition: "Part des personnes de 65 ans ou plus vivant seules dans leur logement, parmi la population des ménages du même âge. Indicateur d'isolement résidentiel des seniors.",
          details: [
            { label: "65-79 ans vivant seuls", count_key: "living_alone_65_79", share_key: "living_alone_rate_65_79" },
            { label: "80 ans ou plus vivant seuls", count_key: "living_alone_80_plus", share_key: "living_alone_rate_80_plus" }
          ] %>

    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Personnes vivant seules selon l'âge (<%= latest %>)</h3>
      <p class="text-xs text-gray-500 mb-4">Part des personnes vivant seules dans chaque tranche d'âge (population des ménages), en %.</p>
      <%= comparison_grouped_bar_chart(territories, latest, [
            ["living_alone_rate_15_24", "15-24 ans"], ["living_alone_rate_25_39", "25-39 ans"],
            ["living_alone_rate_40_54", "40-54 ans"], ["living_alone_rate_55_64", "55-64 ans"],
            ["living_alone_rate_65_79", "65-79 ans"], ["living_alone_rate_80_plus", "80 ans ou plus"]
          ], "Personnes vivant seules par tranche d'âge et par territoire") %>
    </section>

    <!-- 4. Catégorie sociale de la personne de référence -->
    <section style="margin-bottom:1.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Ménages selon la catégorie socioprofessionnelle de la personne de référence (<%= latest %>)</h3>
      <p class="text-xs text-gray-500 mb-4">Répartition des ménages, en %. La personne de référence est en général l'adulte le plus âgé du couple, ou la personne seule.</p>
      <%
        pcs = [
          ["pcs_1_percentage", "Agriculteurs", "#84cc16"],
          ["pcs_2_percentage", "Artisans, commerçants, chefs d'entr.", "#f59e0b"],
          ["pcs_3_percentage", "Cadres, prof. intell. sup.", "#1e3a8a"],
          ["pcs_4_percentage", "Professions intermédiaires", "#3b82f6"],
          ["pcs_5_percentage", "Employés", "#93c5fd"],
          ["pcs_6_percentage", "Ouvriers", "#ef4444"],
          ["pcs_7_percentage", "Retraités", "#9ca3af"],
          ["pcs_9_percentage", "Autres sans activité prof.", "#e5e7eb"]
        ]
      %>
      <%= comparison_stacked_chart(territories, latest, pcs, "Ménages par catégorie socioprofessionnelle et par territoire") %>

      <div class="overflow-x-auto mt-6">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Catégorie (<%= latest %>)</th>
              <% territories.each do |t| %>
                <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider" title="<%= t[:name] %>"><%= t[:key] == :commune ? t[:name] : { epci: "EPCI", department: "Dép.", region: "Région", france: "France métro." }[t[:key]] %></th>
              <% end %>
              <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= comparison %>→<%= latest %></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% pcs.each do |key, label, _| %>
              <tr>
                <td class="px-4 py-2 whitespace-nowrap text-sm text-gray-900"><%= label %></td>
                <% territories.each do |t| %>
                  <td class="px-3 py-2 whitespace-nowrap text-sm text-right <%= t[:main] ? 'font-semibold text-gray-900' : 'text-gray-600' %>"><%= fmt_pct(territory_value(t, latest, key)) %></td>
                <% end %>
                <td class="px-3 py-2 whitespace-nowrap text-right"><%= fmt_trend(hv.(key, comparison), hv.(key)) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="mt-6 pt-4 border-t border-gray-200 text-xs text-gray-500 space-y-1">
      <p>Source : INSEE, recensements de la population <%= years.join(", ") %> (géographie au 1er janvier 2026).</p>
      <p>Les évolutions des taux sont exprimées en points de pourcentage entre <%= comparison %> et <%= latest %> ; la colonne « <%= comparison %>→<%= latest %> » concerne <%= @territory_name %>.</p>
      <p>Ménages ≠ familles : un ménage regroupe les occupants d'un logement ; un logement peut abriter plusieurs familles, ou aucune (personnes seules, colocations).</p>
      <p><span style="color:#d97706">⚠</span> Effectif inférieur à 200 : l'INSEE recommande de l'interpréter avec prudence (imprécision liée au sondage).</p>
    </div>
  <% end %>
</div>
