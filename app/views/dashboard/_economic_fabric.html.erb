<%#
  Bloc « Tissu économique local » de l'onglet Emploi : établissements actifs et postes salariés au 31 décembre
  (INSEE, Flores 2017 et 2021 — API /economic-fabric/*). Rendu dans _employment.
%>
<%
  fabric = comparison_territories("economic_fabric_data", {
    commune: @fabric_data, epci: @epci_fabric_data, department: @department_fabric_data,
    region: @region_fabric_data, france: @france_fabric_data
  })
  f_main = fabric.find { |t| t[:key] == :commune }
  f_france = fabric.find { |t| t[:key] == :france }
  f_years = fabric.flat_map { |t| (t[:data]["available_years"] || []).map(&:to_s) }.uniq.sort
  f_latest, f_start = f_years.last, f_years.first
  fv = ->(t, key, year = f_latest) { t && territory_value(t, year, key) }
  growth = lambda do |t, key|
    a, b = fv.(t, key, f_start), fv.(t, key)
    next nil if a.nil? || b.nil? || a.zero?
    ((b - a) / a * 100).round(1)
  end
  fmt_growth = lambda do |g|
    next content_tag(:span, "–", class: "text-gray-400") if g.nil?
    content_tag(:span, "#{g.positive? ? '+' : (g.negative? ? '−' : '')}#{number_with_precision(g.abs, precision: 1)} %",
                class: g.negative? ? "text-red-600" : "text-green-700")
  end
%>
<% if f_main && f_latest %>
  <h3 class="text-base font-medium text-gray-900 mb-1 mt-4">Tissu économique local</h3>
  <p class="text-xs text-gray-500 mb-4">Établissements actifs employeurs et postes salariés situés sur le territoire au 31 décembre (Flores). La sphère présentielle regroupe les activités tournées vers les besoins des habitants (commerce de proximité, santé, action sociale, enseignement, services publics...) ; la sphère productive, celles qui produisent pour l'extérieur du territoire.</p>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-indigo-50 p-4 rounded-lg">
      <h4 class="text-xs font-medium text-indigo-800">Établissements employeurs (<%= f_latest %>)</h4>
      <p class="text-2xl font-bold text-indigo-900"><%= fmt_count(fv.(f_main, "ets_total")) %></p>
      <p class="text-xs text-gray-600"><%= fmt_growth.(growth.(f_main, "ets_total")) %> depuis <%= f_start %></p>
    </div>
    <div class="bg-teal-50 p-4 rounded-lg">
      <h4 class="text-xs font-medium text-gray-700">Postes salariés (<%= f_latest %>)</h4>
      <p class="text-2xl font-bold text-gray-900"><%= fmt_count(fv.(f_main, "posts_total")) %></p>
      <p class="text-xs text-gray-600"><%= fmt_growth.(growth.(f_main, "posts_total")) %> depuis <%= f_start %> · <%= fmt_decimal(fv.(f_main, "posts_per_ets"), precision: 1) %> postes par établissement</p>
    </div>
    <div class="bg-orange-50 p-4 rounded-lg">
      <h4 class="text-xs font-medium text-orange-800">Économie présentielle</h4>
      <p class="text-2xl font-bold text-orange-900"><%= fmt_pct(fv.(f_main, "presential_posts_share")) %></p>
      <p class="text-xs text-gray-600">des postes salariés · France métropolitaine <%= fmt_pct(fv.(f_france, "presential_posts_share")) %></p>
    </div>
    <div class="bg-purple-50 p-4 rounded-lg">
      <h4 class="text-xs font-medium text-purple-800">Emploi public</h4>
      <p class="text-2xl font-bold text-purple-900"><%= fmt_pct(fv.(f_main, "public_posts_share")) %></p>
      <p class="text-xs text-gray-600">des postes salariés · France métropolitaine <%= fmt_pct(fv.(f_france, "public_posts_share")) %></p>
    </div>
  </div>

  <section style="margin-bottom:2rem">
    <div class="overflow-x-auto mb-6">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-gray-500 border-b">
            <th class="py-2 pr-4 font-medium">Territoire (<%= f_latest %>)</th>
            <th class="py-2 pr-4 font-medium text-right">Établissements</th>
            <th class="py-2 pr-4 font-medium text-right">Postes salariés</th>
            <th class="py-2 pr-4 font-medium text-right">Évolution des postes <%= f_start %>-<%= f_latest %></th>
            <th class="py-2 pr-4 font-medium text-right">Présentiel</th>
            <th class="py-2 pr-4 font-medium text-right">Public</th>
            <th class="py-2 pr-4 font-medium text-right">Établissements de moins de 10 salariés</th>
            <th class="py-2 font-medium text-right">Postes dans les établissements de 50 salariés ou +</th>
          </tr>
        </thead>
        <tbody>
          <% fabric.each do |t| %>
            <tr class="border-b border-gray-100 <%= t[:main] ? 'font-semibold' : '' %>">
              <td class="py-2 pr-4"><%= territory_dot(t) %><%= t[:name] %></td>
              <td class="py-2 pr-4 text-right"><%= fmt_count(fv.(t, "ets_total")) %></td>
              <td class="py-2 pr-4 text-right"><%= fmt_count(fv.(t, "posts_total")) %></td>
              <td class="py-2 pr-4 text-right"><%= fmt_growth.(growth.(t, "posts_total")) %></td>
              <td class="py-2 pr-4 text-right"><%= fmt_pct(fv.(t, "presential_posts_share")) %></td>
              <td class="py-2 pr-4 text-right"><%= fmt_pct(fv.(t, "public_posts_share")) %></td>
              <td class="py-2 pr-4 text-right"><%= fmt_pct(fv.(t, "small_ets_share")) %></td>
              <td class="py-2 text-right"><%= fmt_pct(fv.(t, "large_ets_posts_share")) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <h4 class="text-sm font-medium text-gray-700 mb-1">Postes salariés selon le secteur (<%= f_latest %>)</h4>
    <p class="text-xs text-gray-500 mb-3">En % des postes salariés des établissements du territoire.</p>
    <%= comparison_stacked_chart(fabric, f_latest, [
          ["posts_agriculture_share", "Agriculture", "#84cc16"],
          ["posts_industry_share", "Industrie", "#1e3a8a"],
          ["posts_construction_share", "Construction", "#f59e0b"],
          ["posts_trade_share", "Commerce", "#60a5fa"],
          ["posts_other_market_share", "Transports et services marchands", "#bfdbfe"],
          ["posts_non_market_share", "Adm. publique, enseignement, santé, social", "#0d9488"]
        ], "Postes salariés par secteur et par territoire") %>

    <h4 class="text-sm font-medium text-gray-700 mb-1 mt-6">Établissements selon le nombre de salariés (<%= f_latest %>)</h4>
    <p class="text-xs text-gray-500 mb-3">En % des établissements employeurs.</p>
    <%= comparison_stacked_chart(fabric, f_latest, [
          ["ets_size_0_share", "Aucun salarié au 31/12", "#e5e7eb"],
          ["ets_size_1_9_share", "1 à 9", "#c7d2fe"],
          ["ets_size_10_19_share", "10 à 19", "#818cf8"],
          ["ets_size_20_49_share", "20 à 49", "#4f46e5"],
          ["ets_size_50p_share", "50 ou plus", "#312e81"]
        ], "Établissements par taille et par territoire") %>
    <p class="text-xs text-gray-500 mt-3">Source : INSEE, Flores <%= f_start %> et <%= f_latest %> (établissements actifs employeurs, postes salariés au 31 décembre, hors particuliers employeurs). EPCI, département, région et France métropolitaine : sommes des communes.</p>
  </section>
<% end %>
