<%#
  Onglet Logement — dashboard commune (analyse des besoins sociaux), organisé en questions (onglet pilote de la mise en
  récit : sommaire, « À retenir », une carte par question, cartes IRIS repliées, bascule graphique / tableau).
    1. De quels logements dispose la commune ? (catégories, période de construction, taille, vacance)
    2. Qui occupe les logements ? (statut d'occupation, propriétaires, HLM)
    3. Le parc locatif social (RPLS, _social_housing)
    4. Les logements sont-ils adaptés aux ménages ? (peuplement, personnes par logement, suroccupation)
    5. Se loger pèse-t-il sur le budget des ménages ? (précarité énergétique, chauffage, voiture)
    6. La commune construit-elle ? (Sitadel)
  La mobilité résidentielle est dans l'onglet Ménages.
  Données : INSEE, recensements 2012, 2017, 2023 (API /housing/*) ; Géodip (ONPE) ; SDES (RPLS, Sitadel).
%>
<%
  territories = comparison_territories("housing_data", {
    commune: @housing_data, epci: @epci_housing_data, department: @department_housing_data,
    region: @region_housing_data, france: @france_housing_data
  })
  years = comparison_years(@housing_data, "housing_data")
  latest = comparison_latest_year(@housing_data, years)
  comparison = comparison_start_year(@housing_data, years)
  commune = territories.first
  common = { territories: territories, years: years, latest: latest, comparison: comparison }
  questions = [
    ["q-housing-1", "De quels logements dispose la commune ?"],
    ["q-housing-2", "Qui occupe les logements ?"],
    ["q-housing-3", "Le parc locatif social"],
    ["q-housing-4", "Les logements sont-ils adaptés aux ménages ?"],
    ["q-housing-5", "Se loger pèse-t-il sur le budget des ménages ?"],
    ["q-housing-6", (@epci_mode ? "L'intercommunalité construit-elle ?" : "La commune construit-elle ?")]
  ]

  ep_terrs = comparison_territories("energy_poverty_data", {
    commune: @energy_poverty_data, epci: @epci_energy_poverty_data, department: @department_energy_poverty_data,
    region: @region_energy_poverty_data, france: @france_energy_poverty_data
  })
  ep_years = comparison_years(@energy_poverty_data, "energy_poverty_data")
  ep_latest = comparison_latest_year(@energy_poverty_data, ep_years)
%>
<div class="bg-white shadow rounded-lg p-6 mb-6">
  <h2 class="text-lg font-medium text-gray-900 mb-1">Logement</h2>
  <p class="text-xs text-gray-500 mb-4">Parc de logements et conditions de logement des ménages : six questions pour comprendre la situation du territoire.</p>
  <%= story_summary(questions) %>

  <%= render "dashboard/fragility_ranks", tab: "housing" %>
  <%= story_takeaways("housing") %>

  <% if commune && commune[:main] %>
    <% hv = ->(key, year = latest) { territory_value(commune, year, key) } %>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <% [
           ["Locataires HLM", "tenants_social_percentage", "amber", "des résidences principales"],
           ["Logements vacants", "vacancy_rate", "orange", "des logements"],
           ["Logements suroccupés", "overcrowding_rate", "purple", "des résidences principales"],
           ["Ménages sans voiture", "no_car_percentage", "teal", "des ménages"]
         ].each do |label, key, theme, scope| %>
        <div class="bg-<%= theme %>-50 p-4 rounded-lg">
          <h3 class="text-sm font-medium text-<%= theme %>-800 mb-1"><%= label %></h3>
          <p class="text-2xl font-bold text-<%= theme %>-900"><%= fmt_pct(hv.(key)) %></p>
          <p class="text-xs text-<%= theme %>-700"><%= scope %> · <%= fmt_trend(hv.(key, comparison), hv.(key)) %> depuis <%= comparison %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<% if commune.nil? || !commune[:main] %>
  <div class="bg-white shadow rounded-lg p-6 mb-6"><p class="text-sm text-gray-500">Données logement indisponibles pour ce territoire.</p></div>
<% else %>
  <% hv = ->(key, year = latest) { territory_value(commune, year, key) } %>

  <%= story_card("q-housing-1", 1, "De quels logements dispose la commune ?",
        "#{fmt_count(hv.("dwellings"))} logements en #{latest}, dont #{fmt_count(hv.("dwellings_main"))} résidences principales : nature, ancienneté et taille du parc.") do %>
    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Catégories de logements (<%= latest %>)</h3>
      <%= indicator_notes("housing__categories_de_logements") do %>Part de chaque catégorie dans l'ensemble des logements, en %.<% end %>
      <%= comparison_stacked_chart(territories, latest, [
            ["main_rate", "Résidences principales", "#1d4ed8"],
            ["secondary_rate", "Résidences secondaires et logements occasionnels", "#93c5fd"],
            ["vacancy_rate", "Logements vacants", "#f59e0b"]
          ], "Catégories de logements par territoire") %>
    </section>

    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Période de construction des résidences principales (<%= latest %>)</h3>
      <%= indicator_notes("housing__periode_de_construction_des_residences_principales") do %>Logements achevés avant <%= latest.to_i - 2 %>, en %. Les logements anciens, surtout d'avant 1975 (premières réglementations thermiques), sont les plus exposés aux besoins de rénovation énergétique.<% end %>
      <%= comparison_stacked_chart(territories, latest, [
            ["built_lt1919_percentage", "Avant 1919", "#7c2d12"],
            ["built_1919_1945_percentage", "1919 à 1945", "#c2410c"],
            ["built_1946_1970_percentage", "1946 à 1970", "#f59e0b"],
            ["built_1971_1990_percentage", "1971 à 1990", "#fde68a"],
            ["built_1991_2005_percentage", "1991 à 2005", "#93c5fd"],
            ["built_2006_plus_percentage", "2006 ou après", "#1d4ed8"]
          ], "Période de construction par territoire") %>
    </section>

    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Taille des résidences principales (<%= latest %>)</h3>
      <%= indicator_notes("housing__taille_des_residences_principales") do %>Nombre de pièces, en %.<% end %>
      <%= comparison_stacked_chart(territories, latest, [
            ["rooms_r1_percentage", "1 pièce", "#fde68a"],
            ["rooms_r2_percentage", "2 pièces", "#f59e0b"],
            ["rooms_r3_percentage", "3 pièces", "#93c5fd"],
            ["rooms_r4_percentage", "4 pièces", "#3b82f6"],
            ["rooms_r5p_percentage", "5 pièces ou plus", "#1e3a8a"]
          ], "Taille des résidences principales par territoire") %>
    </section>

    <%= render "dashboard/territory_indicator", **common,
          title: "Logements vacants", theme: "orange",
          value_key: "vacancy_rate",
          count_key: "dwellings_vacant", total_key: "dwellings", count_label: "logements",
          definition: "Part des logements inoccupés au moment du recensement (en vente, en location, en attente d'occupation ou sans affectation). Au-delà de 8 à 10 %, la vacance signale souvent un parc dégradé, inadapté ou un marché peu tendu.",
          details: [
            { label: "Résidences secondaires", share_key: "secondary_rate" },
            { label: "Maisons (ensemble des logements)", share_key: "houses_percentage" },
            { label: "Appartements (ensemble des logements)", share_key: "apartments_percentage" }
          ] %>

    <%= render "dashboard/map_group", maps: [
      { kind: :iris, map: cached_iris_map("vacancy_rate"),
        definition: "Logements vacants, en % de l'ensemble des logements de l'IRIS." },
      { kind: :iris, map: cached_iris_map("apartments_share"),
        definition: "Appartements, en % de l'ensemble des logements de l'IRIS." },
      { kind: :iris, map: cached_iris_map("small_dwellings_share"),
        definition: "Résidences principales de 1 ou 2 pièces, en % des résidences principales de l'IRIS : logements de personnes seules et de petits ménages." }
    ] %>

    <div class="pt-4 border-t border-gray-200 text-xs text-gray-500 space-y-1">
      <p>Source : INSEE, recensements de la population <%= years.join(", ") %> (géographie au 1er janvier 2026). Évolutions en points de pourcentage entre <%= comparison %> et <%= latest %>. <span style="color:#d97706">⚠</span> Effectif inférieur à 200 : à interpréter avec prudence.</p>
    </div>
  <% end %>

  <%= story_card("q-housing-2", 2, "Qui occupe les logements ?",
        "Statut d'occupation des ménages : propriétaires, locataires du parc privé ou social. Le parc social est détaillé dans la question suivante.") do %>
    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Statut d'occupation des résidences principales (<%= latest %>)</h3>
      <%= indicator_notes("housing__statut_d_occupation_des_residences_principales") do %>En %.<% end %>
      <%= comparison_stacked_chart(territories, latest, [
            ["owners_percentage", "Propriétaires", "#1e3a8a"],
            ["tenants_private_percentage", "Locataires du parc privé", "#3b82f6"],
            ["tenants_social_percentage", "Locataires HLM", "#f59e0b"],
            ["tenants_furnished_percentage", "Meublé, chambre d'hôtel", "#93c5fd"],
            ["free_percentage", "Logés gratuitement", "#e5e7eb"]
          ], "Statut d'occupation par territoire") %>
    </section>

    <%= render "dashboard/territory_indicator", **common,
          title: "Propriétaires occupants", theme: "amber",
          value_key: "owners_percentage",
          count_key: "main_owners", total_key: "dwellings_main", count_label: "résidences principales",
          definition: "Part des résidences principales occupées par leur propriétaire. Une part élevée de propriétaires âgés ou modestes peut signaler des besoins d'adaptation ou de rénovation du logement." %>

    <%= render "dashboard/territory_indicator", **common,
          title: "Locataires HLM", theme: "amber",
          value_key: "tenants_social_percentage",
          count_key: "main_tenants_social", total_key: "dwellings_main", count_label: "résidences principales",
          definition: "Part des résidences principales occupées par un ménage locataire d'un logement HLM loué vide. Repère du poids du parc social et des publics qu'il accueille.",
          details: [
            { label: "Locataires du parc privé", share_key: "tenants_private_percentage" },
            { label: "Locataires d'un meublé ou d'une chambre d'hôtel", share_key: "tenants_furnished_percentage" },
            { label: "Logés gratuitement", share_key: "free_percentage" }
          ] %>

    <%= render "dashboard/map_group", maps: [
        { kind: :iris, map: cached_iris_map("social_housing_share"), 
          definition: "Résidences principales louées vides en HLM, en % des résidences principales de l'IRIS.",
          commune_latest: { year: latest, value: territory_value(commune, latest, "tenants_social_percentage"),
                            count: territory_value(commune, latest, "main_tenants_social"), total: territory_value(commune, latest, "dwellings_main") } },
        { kind: :grid, map: cached_grid_map("social_housing_share"), 
          definition: "Ménages logés dans le parc social, en % des ménages du carreau (2021)." }
      ] %>
    <%= render "dashboard/iris_map", map: cached_iris_map("owners_share"), collapsed: true,
          definition: "Résidences principales occupées par leur propriétaire, en % des résidences principales de l'IRIS." %>

    <div class="pt-4 border-t border-gray-200 text-xs text-gray-500 space-y-1">
      <p>Source : INSEE, recensements de la population <%= years.join(", ") %> (géographie au 1er janvier 2026). Évolutions en points de pourcentage entre <%= comparison %> et <%= latest %>. <span style="color:#d97706">⚠</span> Effectif inférieur à 200 : à interpréter avec prudence.</p>
    </div>
  <% end %>

  <%= render "dashboard/social_housing", heading: "3. Le parc locatif social", card_id: "q-housing-3" %>

  <%= story_card("q-housing-4", 4, "Les logements sont-ils adaptés aux ménages ?",
        "Adéquation entre la taille des logements et celle des ménages : suroccupation, sous-occupation, taille moyenne des ménages.") do %>
    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Peuplement des résidences principales (<%= latest %>)</h3>
      <%= indicator_notes("housing__peuplement_des_residences_principales") do %>En %. La sous-occupation concerne surtout des personnes âgées vivant seules ou en couple dans de grands logements.<% end %>
      <%= comparison_stacked_chart(territories, latest, [
            ["occ_over_severe_percentage", "Suroccupation accentuée", "#b91c1c"],
            ["occ_over_moderate_percentage", "Suroccupation modérée", "#ef4444"],
            ["occ_standard_percentage", "Peuplement normal", "#e5e7eb"],
            ["occ_under_moderate_percentage", "Sous-occupation modérée", "#93c5fd"],
            ["occ_under_severe_percentage", "Sous-occupation accentuée", "#3b82f6"],
            ["occ_under_very_severe_percentage", "Sous-occupation très accentuée", "#1e3a8a"]
          ], "Peuplement des résidences principales par territoire") %>
    </section>

    <% if @epci_mode %>
      <%# Tableau de bord EPCI : suroccupation (modérée + accentuée) et sous-occupation (modérée + accentuée + très accentuée) par commune %>
      <%= render "dashboard/map_group", maps: [
          { kind: :communes, map: epci_indicator_map(territories, "overcrowding_rate", title: "Logements suroccupés",
                                                     value_format: :pct, years: [comparison, latest]),
            definition: "Suroccupation modérée et accentuée : résidences principales où il manque au moins une pièce au regard de la composition du ménage, en % des résidences principales." },
          { kind: :communes, map: epci_indicator_map(territories, "under_occupation_rate", title: "Logements sous-occupés",
                                                     value_format: :pct, years: [comparison, latest]),
            definition: "Sous-occupation modérée, accentuée et très accentuée : résidences principales comptant au moins une pièce de plus que le besoin du ménage, en % des résidences principales." }
        ] %>
    <% end %>

    <%= render "dashboard/territory_indicator", **common,
          title: "Nombre moyen de personnes par logement", theme: "purple",
          value_key: "persons_per_dwelling", value_format: :decimal, unit: "pers.",
          definition: "Population des ménages rapportée au nombre de résidences principales. Sa baisse traduit le desserrement des ménages (vieillissement, séparations, décohabitation)." %>

    <%= render "dashboard/territory_indicator", **common,
          title: "Logements suroccupés", theme: "purple",
          value_key: "overcrowding_rate", communes_map: false,
          definition: "Part des résidences principales où le nombre de pièces est inférieur au besoin du ménage (une pièce de séjour, une pièce par couple, par adulte et par paire d'enfants). La suroccupation est un marqueur de mal-logement.",
          details: [
            { label: "Dont suroccupation accentuée", share_key: "severe_overcrowding_rate" },
            { label: "Sous-occupation (toutes intensités)", share_key: "under_occupation_rate" },
            { label: "Logements de 1 ou 2 pièces", share_key: "small_dwellings_percentage" }
          ] %>

    <%= render "dashboard/map_group", maps: [
      { kind: :iris, map: cached_iris_map("overcrowding_rate"),
        definition: "Résidences principales suroccupées (il manque au moins une pièce au regard de la composition du ménage), en % des résidences principales de l'IRIS." },
      { kind: :iris, map: cached_iris_map("underoccupation_rate"),
        definition: "Résidences principales sous-occupées (au moins une pièce de plus que le besoin du ménage), en % des résidences principales de l'IRIS." }
    ] %>

    <div class="pt-4 border-t border-gray-200 text-xs text-gray-500 space-y-1">
      <p>Source : INSEE, recensements de la population <%= years.join(", ") %> (géographie au 1er janvier 2026) ; peuplement : exploitation complémentaire. Évolutions en points de pourcentage entre <%= comparison %> et <%= latest %>. <span style="color:#d97706">⚠</span> Effectif inférieur à 200 : à interpréter avec prudence.</p>
    </div>
  <% end %>

  <%= story_card("q-housing-5", 5, "Se loger pèse-t-il sur le budget des ménages ?",
        "Dépenses contraintes liées au logement : énergie pour se chauffer et s'éclairer, dépendance à la voiture.") do %>
    <% if ep_terrs.first&.dig(:main) && ep_years.any? %>
      <%= render "dashboard/territory_indicator", territories: ep_terrs, years: ep_years, latest: ep_latest, comparison: ep_latest,
            title: "Ménages en précarité énergétique logement", theme: "red",
            value_key: "energy_poverty_rate",
            count_key: "energy_poverty_households", count_label: "ménages",
            definition: "Ménages dont les dépenses théoriques d'énergie pour le logement (chauffage, eau chaude, électricité) dépassent 8 % de leurs ressources et dont le niveau de vie est parmi les 30 % les plus modestes. Source : Observatoire national de la précarité énergétique (Géodip), #{ep_latest} ; estimation du ministère de la Transition écologique (modèle Prometheus) ; un seul millésime, pas d'évolution. France : France métropolitaine, pas d'estimation pour l'outre-mer." %>
    <% end %>
    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Combustible principal de chauffage (<%= latest %>)</h3>
      <%= indicator_notes("housing__combustible_principal_de_chauffage") do %>Résidences principales, en %. Le fioul et le gaz en bouteille exposent davantage les ménages à la précarité énergétique.<% end %>
      <%= comparison_stacked_chart(territories, latest, [
            ["heat_town_gas_percentage", "Gaz de ville, réseau de chaleur", "#1d4ed8"],
            ["heat_electric_percentage", "Électricité", "#93c5fd"],
            ["heat_oil_percentage", "Fioul", "#ef4444"],
            ["heat_bottled_gas_percentage", "Gaz en bouteille ou citerne", "#f59e0b"],
            ["heat_other_percentage", "Autre (bois, pompe à chaleur...)", "#84cc16"]
          ], "Combustible principal de chauffage par territoire") %>
    </section>

    <% if @epci_mode %>
      <%# Tableau de bord EPCI : combustible principal de chauffage par commune (gaz, électricité, fioul, autre) %>
      <%
        heat_map = ->(title, keys, definition) do
          { kind: :communes, definition: definition,
            map: epci_computed_map(territories, title: title, value_format: :pct, year: latest) { |sr| epci_sum_keys(sr, latest, keys) } }
        end
      %>
      <%= render "dashboard/map_group", maps: [
          heat_map.("Chauffage au gaz", %w[heat_town_gas_percentage heat_bottled_gas_percentage],
                    "Résidences principales chauffées au gaz (gaz de ville ou réseau de chaleur, gaz en bouteille ou citerne), en %."),
          heat_map.("Chauffage à l'électricité", %w[heat_electric_percentage], "Résidences principales chauffées à l'électricité, en %."),
          heat_map.("Chauffage au fioul", %w[heat_oil_percentage], "Résidences principales chauffées au fioul, en %."),
          heat_map.("Autre chauffage (bois, pompe à chaleur…)", %w[heat_other_percentage],
                    "Résidences principales chauffées par un autre combustible (bois, pompe à chaleur, solaire…), en %.")
        ] %>
    <% end %>

    <%= render "dashboard/territory_indicator", **common,
          title: "Ménages sans voiture", theme: "teal",
          value_key: "no_car_percentage",
          count_key: "cars_0", total_key: "dwellings_main", count_label: "ménages",
          definition: "Part des ménages ne disposant d'aucune voiture. À lire avec l'offre de transports en commun : hors grandes villes, l'absence de voiture freine l'accès à l'emploi, aux soins et aux services.",
          details: [
            { label: "Une voiture", share_key: "one_car_percentage" },
            { label: "Deux voitures ou plus", share_key: "two_cars_percentage" },
            { label: "Au moins un emplacement de stationnement", share_key: "parking_percentage" }
          ] %>

    <%= render "dashboard/map_group", maps: [
      { kind: :iris, map: cached_iris_map("no_car_share"),
        definition: "Ménages sans voiture, en % des ménages de l'IRIS.",
        commune_latest: { year: latest, value: territory_value(commune, latest, "no_car_percentage"),
                            count: territory_value(commune, latest, "cars_0"), total: territory_value(commune, latest, "dwellings_main") } },
      { kind: :iris, map: cached_iris_map("two_cars_share"),
        definition: "Ménages disposant d'au moins deux voitures, en % des ménages de l'IRIS : place de la mobilité automobile." }
    ] %>
    <div class="pt-4 border-t border-gray-200 text-xs text-gray-500 space-y-1">
      <p>Source : INSEE, recensements de la population <%= years.join(", ") %> (géographie au 1er janvier 2026) ; précarité énergétique : Géodip (ONPE). Évolutions en points de pourcentage entre <%= comparison %> et <%= latest %>. <span style="color:#d97706">⚠</span> Effectif inférieur à 200 : à interpréter avec prudence.</p>
    </div>
  <% end %>
<% end %>

<%= render "dashboard/construction", heading: "6. #{@epci_mode ? "L'intercommunalité construit-elle ?" : 'La commune construit-elle ?'}", card_id: "q-housing-6" %>
