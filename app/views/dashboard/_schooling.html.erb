<%#
  Organisé en questions : 1. scolarisation par âge (_schooling_by_age) ; 2 à 4. établissements (_schools : IPS, valeur ajoutée, éloignement).
  Onglet Scolarité (regroupe les anciens onglets Scolarisation et Éducation nationale) :
    1. scolarisation par âge des enfants et jeunes qui habitent la commune — INSEE, recensements 2012, 2017, 2023
       (API /education-training/*), y compris 2 ans et 3-5 ans ;
    2. établissements situés dans la commune — IPS, valeur ajoutée, éloignement (DEPP, API /schools/*, partial _schools).
%>
<%
  questions = [
    ["q-schooling-1", "Les enfants et les jeunes de la commune sont-ils scolarisés ?"],
    ["q-schooling-2", "Quel public accueillent les écoles, collèges et lycées de la commune ?"],
    ["q-schooling-3", "Les collèges et les lycées font-ils progresser leurs élèves ?"],
    ["q-schooling-4", "Les collèges et les lycées sont-ils éloignés des ressources ?"]
  ]
%>
<div class="bg-white shadow rounded-lg p-6 mb-6">
  <h2 class="text-lg font-medium text-gray-900 mb-1">Scolarité</h2>
  <p class="text-xs text-gray-500 mb-4">La scolarisation des enfants et des jeunes qui habitent <%= la_commune %> (recensement), puis les écoles, collèges et lycées situés dans <%= la_commune %> (Éducation nationale) : quatre questions.</p>
  <%= story_summary(questions) %>

  <%= render "dashboard/fragility_ranks", tab: "schooling" %>
</div>

<%= story_card("q-schooling-1", 1, "Les enfants et les jeunes de la commune sont-ils scolarisés ?",
      "Part des enfants et des jeunes qui habitent la commune inscrits dans un établissement d'enseignement, quel que soit le lieu de cet établissement (recensement).") do %>
  <%= render "dashboard/schooling_by_age" %>
<% end %>

<%= render "dashboard/schools" %>
