<%#
  Position de la commune parmi les communes (API /fragility-synthesis/commune/*), affichée en tête d'un onglet
  thématique, avant les tableaux par échelle. Bascule entre le rang parmi les communes de l'EPCI (défaut, calculé à la
  volée par l'API), le rang dans la catégorie de densité INSEE et le rang parmi toutes les communes de France.
  locals : theme (clé d'enjeu : poverty, employment, youth, families, seniors, health, housing, safety)
           ou keys (liste de clés d'indicateurs, synthèse ou contexte, dans l'ordre voulu ; pas de niveau d'enjeu)
           ou group (groupe de repères de contexte : population, households, immigration, early_childhood,
           schooling, rights, local_life — liste d'indicateurs fournie par l'API)
  Nécessite @fragility_synthesis (load_fragility_synthesis).
%>
<%
  theme ||= nil
  keys ||= nil
  group ||= nil
  syn = @fragility_synthesis.is_a?(Hash) && @fragility_synthesis["error"].blank? ? @fragility_synthesis : nil
  keys ||= syn && group && syn["context_groups"].to_a.find { |g| g["key"] == group }&.dig("indicators")
  all_items = syn ? syn["indicators"].to_a + syn["context_indicators"].to_a : []
  th = syn && (theme || group) && syn["themes"].find { |t| t["key"] == (theme || group) }
  items = if keys
            keys.filter_map { |k| all_items.find { |i| i["key"] == k } }
          else
            all_items.select { |i| i["theme"] == theme }
          end
  items = items.reject { |i| i["value"].nil? }
%>
<% if syn && items.any? %>
  <%
    levels = { "high" => ["Enjeu fort", "#fee2e2", "#b91c1c"], "moderate" => ["Enjeu modéré", "#ffedd5", "#c2410c"],
               "low" => ["Enjeu faible", "#ecfdf5", "#047857"], "not_evaluable" => ["Non évaluable", "#f3f4f6", "#6b7280"],
               "context" => ["Contexte", "#eef2ff", "#4f46e5"] }
    lvl, lvl_bg, lvl_fg = th ? levels[th["level"]] : nil
    fmt_v = lambda do |i, v|
      next "–" if v.nil?
      case i["unit"]
      when "%" then fmt_pct(v)
      when "€" then "#{fmt_count(v)} €"
      when "‰" then "#{fmt_decimal(v, precision: 1)} ‰"
      else fmt_decimal(v, precision: 1)
      end
    end
    position = lambda do |r, neutral = false|
      next "" if r.nil?
      if neutral
        if r >= 80 then "parmi les #{[(100 - r).ceil, 1].max} % de communes aux valeurs les plus élevées"
        elsif r <= 20 then "parmi les #{[r.ceil, 1].max} % de communes aux valeurs les plus faibles"
        else "dans la moyenne"
        end
      elsif r >= 80 then "parmi les #{[(100 - r).ceil, 1].max} % les plus touchées"
      elsif r <= 20 then "parmi les #{[r.ceil, 1].max} % les moins touchées"
      else "dans la moyenne"
      end
    end
    dens = syn.dig("density", "label")
    epci = syn["epci"].is_a?(Hash) && items.any? { |i| i["rank_epci"] } ? syn["epci"] : nil
    ordinal = ->(k) { k == 1 ? "1re" : "#{k}e" }
    epci_position = lambda do |i, neutral|
      next "" if i["epci_position"].nil?
      k = i["epci_position"]
      neutral ? "#{ordinal.(k)} valeur la plus élevée" : (k == 1 ? "la plus touchée" : "#{ordinal.(k)} plus touchée")
    end
    # du plus petit niveau au plus grand ; ouverture sur le rang EPCI (catégorie si la commune n'a pas de rang EPCI)
    modes = [["dens", "Rang dans la catégorie"], ["fr", "Rang France"]]
    modes.unshift(["epci", "Rang dans l'EPCI"]) if epci
    default_mode = modes.first[0]
    btn = "padding:4px 10px;font-size:12px;border:1px solid #c7d2fe;cursor:pointer"
    toggle = "var b=this,s=b.closest('section');s.querySelectorAll('[data-rank-mode]').forEach(function(e){e.style.display=e.getAttribute('data-rank-mode')===b.getAttribute('data-mode')?'':'none'});s.querySelectorAll('button[data-mode]').forEach(function(x){var on=x===b;x.style.background=on?'#4f46e5':'#fff';x.style.color=on?'#fff':'#3730a3'})"
  %>
  <section style="margin:0 0 2rem;padding:16px 18px;border:1px solid #e0e7ff;border-radius:12px;background:#f8faff">
    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px">
      <div>
        <h3 class="text-base font-medium text-gray-900">Position de <%= @territory_name %> parmi les communes
          <% if lvl %><span style="display:inline-block;margin-left:6px;padding:2px 8px;border-radius:999px;font-size:12px;background:<%= lvl_bg %>;color:<%= lvl_fg %>"><%= lvl %></span><% end %>
        </h3>
      </div>
      <div style="display:inline-flex;border-radius:8px;overflow:hidden">
        <% modes.each_with_index do |(mode, label), idx| %>
          <%
            radius = idx.zero? ? "8px 0 0 8px" : (idx == modes.size - 1 ? "0 8px 8px 0" : "0")
            on = mode == default_mode
          %>
          <button type="button" data-mode="<%= mode %>" onclick="<%= toggle %>" style="<%= btn %>;<%= idx.zero? ? '' : 'border-left:none;' %>border-radius:<%= radius %>;background:<%= on ? '#4f46e5' : '#fff' %>;color:<%= on ? '#fff' : '#3730a3' %>"><%= label %></button>
        <% end %>
      </div>
    </div>
    <p class="text-xs text-gray-500" data-rank-mode="dens" style="margin-bottom:10px;<%= default_mode == 'dens' ? '' : 'display:none' %>">Parmi les communes de même densité (<%= dens || "catégorie inconnue" %>). 0 = la moins touchée, 100 = la plus touchée ; zone rouge : 20 % les plus touchées, zone verte : 20 % les moins touchées<%= items.any? { |i| i["direction"] == "neutral" } ? " ; barre bleue : indicateur de structure, classé de la valeur la plus faible (0) à la plus élevée (100), sans jugement" : "" %>.</p>
    <p class="text-xs text-gray-500" data-rank-mode="fr" style="margin-bottom:10px;display:none">Parmi toutes les communes de France ayant une valeur publiée. 0 = la moins touchée, 100 = la plus touchée ; zone rouge : 20 % les plus touchées, zone verte : 20 % les moins touchées<%= items.any? { |i| i["direction"] == "neutral" } ? " ; barre bleue : indicateur de structure, classé de la valeur la plus faible (0) à la plus élevée (100), sans jugement" : "" %>.</p>
    <% if epci %>
      <p class="text-xs text-gray-500" data-rank-mode="epci" style="margin-bottom:10px">Parmi les communes de <%= epci["label"] %> ayant une valeur publiée (<%= fmt_count(epci["communes"]) %> communes dans l'EPCI). 0 = la moins touchée, 100 = la plus touchée ; zone rouge : 20 % les plus touchées, zone verte : 20 % les moins touchées<%= items.any? { |i| i["direction"] == "neutral" } ? " ; barre bleue : indicateur de structure, classé de la valeur la plus faible (0) à la plus élevée (100), sans jugement" : "" %>. Dans un EPCI de peu de communes, une seule commune d'écart déplace fortement le rang.</p>
    <% end %>
    <div>
      <% items.each do |i| %>
        <div style="display:grid;grid-template-columns:minmax(200px,2fr) 90px minmax(160px,3fr);gap:12px;align-items:center;padding:6px 0;border-top:1px solid #eef2ff">
          <div class="text-sm text-gray-800"><%= i["label"] %> <span class="text-xs text-gray-400">(<%= i["year"] %>)</span></div>
          <div class="text-sm text-right font-semibold whitespace-nowrap"><%= fmt_v.(i, i["value"]) %></div>
          <%
            rank_modes = [["dens", i["rank_density"], i["density_n"], i["density_median"], "médiane de la catégorie"],
                          ["fr", i["rank_france"], i["france_n"], i["france_value"], "France"]]
            rank_modes << ["epci", i["rank_epci"], i["epci_n"], i["epci_median"], "médiane de l'EPCI"] if epci
          %>
          <% rank_modes.each do |mode, r, n, ref, ref_label| %>
            <div data-rank-mode="<%= mode %>" style="<%= mode == default_mode ? '' : 'display:none' %>">
              <% if r %>
                <% neutral = i["direction"] == "neutral"; alert = !neutral && r >= 80; good = !neutral && r <= 20 && !i["need"] %>
                <div style="position:relative;height:10px;border-radius:5px;background:<%= neutral ? 'linear-gradient(90deg,#eef2ff,#c7d2fe)' : 'linear-gradient(90deg,#d1fae5 0 20%,#f3f4f6 20% 80%,#fee2e2 80% 100%)' %>" title="Rang <%= r.round %> sur 100">
                  <span style="position:absolute;top:-3px;left:calc(<%= r %>% - 4px);width:8px;height:16px;border-radius:3px;background:<%= neutral ? '#4f46e5' : (alert ? '#b91c1c' : (good ? '#047857' : '#4b5563')) %>"></span>
                </div>
                <div class="text-xs text-gray-500" style="margin-top:3px"><% if mode == "epci" %><%= epci_position.(i, neutral) %><%= n ? " sur #{fmt_count(n)} communes" : "" %><% else %><%= position.(r, neutral) %><%= n ? " · #{fmt_count(n)} communes" : "" %><% end %><%= ref ? " · #{ref_label} #{fmt_v.(i, ref)}" : "" %></div>
              <% else %>
                <span class="text-xs text-gray-400">commune non classée</span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <p class="text-xs text-gray-500" style="margin-top:8px">
      <button type="button" data-action="click->dashboard-tabs#showTab" data-tab="fragility" style="color:#4f46e5">Voir la synthèse de tous les enjeux</button>
    </p>
  </section>
<% end %>
