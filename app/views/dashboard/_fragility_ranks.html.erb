<%#
  Position de la commune parmi les communes (API /fragility-synthesis/commune/*), affichée en tête d'un onglet,
  avant les tableaux par échelle. Indicateurs de l'onglet : liste « tab_keys » de l'API (catalogue de la synthèse).
  Lecture en intensité de l'enjeu, du bleu (moins marqué qu'ailleurs) au rouge (plus marqué) : FragilityIntensityHelper.
  Bascule entre le rang parmi les communes de l'EPCI (défaut, calculé à la volée par l'API), dans la catégorie de
  densité INSEE et parmi toutes les communes de France.
  locals : tab (identifiant de l'onglet : synthese, households, families, housing, children_comparison, youth,
           schooling, diplomas, employment, local_economy, revenues_poverty, immigration, caf_benefits, health,
           seniors, local_life, delinquency)
  Nécessite @fragility_synthesis (load_fragility_synthesis).
%>
<%
  syn = @fragility_synthesis.is_a?(Hash) && @fragility_synthesis["error"].blank? ? @fragility_synthesis : nil
  keys = syn ? (syn.dig("tab_keys", tab) || []) : []
  all_items = syn ? (syn["indicators"].to_a + syn["context_indicators"].to_a).index_by { |i| i["key"] } : {}
  items = keys.filter_map { |k| all_items[k] }.reject { |i| i["value"].nil? }
  # Intensité de l'enjeu de l'onglet pour chaque échelle (même calcul que la tuile de la Synthèse) : moyenne des
  # intensités et part des indicateurs à forte intensité (FragilityIntensityHelper#enjeu_level) ; le badge suit le bouton
  enjeu_items = keys.filter_map { |k| all_items[k] }
  mode_rank = { "epci" => ->(i) { i["rank_epci"] }, "dens" => ->(i) { i["rank_density"] || i["rank_france"] },
                "fr" => ->(i) { i["rank_france"] } }
  mode_levels = enjeu_items.any? ? mode_rank.transform_values { |f| enjeu_level(enjeu_items.map { |i| i["value"].nil? ? nil : enjeu_intensity(i, f.(i)) }, enjeu_items.size) } : {}
%>
<% if syn && items.any? %>
  <%
    fmt_v = lambda do |i, v|
      next "–" if v.nil?
      case i["unit"]
      when "%" then fmt_pct(v)
      when "€" then "#{fmt_count(v)} €"
      when "‰" then "#{fmt_decimal(v, precision: 1)} ‰"
      when "%/an" then "#{v.positive? ? '+' : ''}#{fmt_decimal(v, precision: 2)} %/an"
      else fmt_decimal(v, precision: 1)
      end
    end
    dens = syn.dig("density", "label")
    epci = syn["epci"].is_a?(Hash) && items.any? { |i| i["rank_epci"] } ? syn["epci"] : nil
    # du plus petit niveau au plus grand ; ouverture sur le rang EPCI (catégorie si la commune n'a pas de rang EPCI)
    # Tableau de bord EPCI : rang parmi les EPCI de même nature (rank_density) et parmi tous les EPCI (rank_france)
    ep = @epci_mode
    unit_pl = ep ? "EPCI" : "communes"
    modes = ep ? [["dens", "Rang parmi les EPCI de même nature"], ["fr", "Rang parmi tous les EPCI"]] :
                 [["dens", "Rang dans la catégorie"], ["fr", "Rang France"]]
    modes.unshift(["epci", "Rang dans l'EPCI"]) if epci
    default_mode = modes.first[0]
    pill = "display:inline-block;padding:2px 9px;border-radius:999px;background:#dbeafe;color:#1e40af;font-weight:600"
    btn = "padding:4px 10px;font-size:12px;border:1px solid #c7d2fe;cursor:pointer"
    toggle = "var b=this,s=b.closest('section');s.querySelectorAll('[data-rank-mode]').forEach(function(e){e.style.display=e.getAttribute('data-rank-mode')===b.getAttribute('data-mode')?'':'none'});s.querySelectorAll('button[data-mode]').forEach(function(x){var on=x===b;x.style.background=on?'#4f46e5':'#fff';x.style.color=on?'#fff':'#3730a3'})"
  %>
  <section style="margin:0 0 2rem;padding:16px 18px;border:1px solid #e0e7ff;border-radius:12px;background:#f8faff">
    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px">
      <div>
        <h3 class="text-base font-medium text-gray-900" data-plain-title>Position de <%= @territory_name %> parmi les <%= unit_pl %>
          <% modes.each do |mode, _| %>
            <% lvl, lvl_bg, lvl_fg = mode_levels[mode] && enjeu_level_badge(mode_levels[mode]) %>
            <% if lvl %><span data-rank-mode="<%= mode %>" style="display:<%= mode == default_mode ? 'inline-block' : 'none' %>;margin-left:6px;padding:2px 8px;border-radius:999px;font-size:12px;background:<%= lvl_bg %>;color:<%= lvl_fg %>"><%= lvl %></span><% end %>
          <% end %>
        </h3>
        <% modes.each do |mode, _| %>
          <div class="text-xs text-gray-600" data-rank-mode="<%= mode %>" style="margin-top:4px;<%= mode == default_mode ? '' : 'display:none' %>">
            <% if mode == "epci" %>Comparaison avec les communes de l'EPCI : <span style="<%= pill %>"><%= epci["label"] %></span>
            <% elsif mode == "dens" && ep %>Comparaison avec les EPCI de même nature : <span style="<%= pill %>"><%= dens || "nature inconnue" %></span>
            <% elsif mode == "dens" %>Comparaison avec les communes de la catégorie de densité : <span style="<%= pill %>"><%= dens || "non classée" %></span>
            <% elsif ep %>Comparaison avec <span style="<%= pill %>">tous les EPCI de France</span>
            <% else %>Comparaison avec <span style="<%= pill %>">toutes les communes de France</span><% end %>
          </div>
        <% end %>
      </div>
      <div style="display:inline-flex;border-radius:8px;overflow:hidden">
        <% modes.each_with_index do |(mode, label), idx| %>
          <%
            radius = idx.zero? ? "8px 0 0 8px" : (idx == modes.size - 1 ? "0 8px 8px 0" : "0")
            on = mode == default_mode
          %>
          <button type="button" data-mode="<%= mode %>" onclick="<%= toggle %>" style="<%= btn %>;<%= idx.zero? ? '' : 'border-left:none;' %>border-radius:<%= radius %>;background:<%= on ? '#4f46e5' : '#fff' %>;color:<%= on ? '#fff' : '#3730a3' %>"><%= label %></button>
        <% end %>
      </div>
    </div>
    <p class="text-xs text-gray-500" style="margin-bottom:6px"><%= ep ? FragilityIntensityHelper::INTENSITY_LEGEND.gsub("dans la commune", "dans l'EPCI").gsub("autres communes", "autres EPCI") : FragilityIntensityHelper::INTENSITY_LEGEND %></p>
    <div class="text-xs text-gray-500" style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
      <span style="color:<%= FragilityIntensityHelper::INTENSITY_BLUE %>;font-weight:600">enjeu moins marqué</span>
      <span style="display:inline-block;width:120px;height:8px;border-radius:4px;background:<%= FragilityIntensityHelper::INTENSITY_GRADIENT %>"></span>
      <span style="color:<%= FragilityIntensityHelper::INTENSITY_RED %>;font-weight:600">enjeu plus marqué</span>
      <% if epci %><span data-rank-mode="epci">· dans un EPCI de peu de communes, une seule commune d'écart déplace fortement le rang</span><% end %>
    </div>
    <div>
      <% items.each do |i| %>
        <div style="display:grid;grid-template-columns:minmax(200px,2fr) 90px minmax(160px,3fr);gap:12px;align-items:center;padding:6px 0;border-top:1px solid #eef2ff">
          <div class="text-sm text-gray-800"><%= enjeu_label(i) %> <span class="text-xs text-gray-400">(<%= i["year"] %>)</span></div>
          <div class="text-sm text-right font-semibold whitespace-nowrap"><%= fmt_v.(i, i["value"]) %></div>
          <%
            rank_modes = [["dens", i["rank_density"], i["density_n"], i["density_median"], ep ? "médiane des EPCI de même nature" : "médiane de la catégorie"],
                          ["fr", i["rank_france"], i["france_n"], i["france_value"], "France"]]
            rank_modes << ["epci", i["rank_epci"], i["epci_n"], i["epci_median"], "médiane de l'EPCI"] if epci
          %>
          <% rank_modes.each do |mode, r, n, ref, ref_label| %>
            <div data-rank-mode="<%= mode %>" style="<%= mode == default_mode ? '' : 'display:none' %>">
              <% if r %>
                <%= enjeu_bar(i, r) %>
                <div class="text-xs text-gray-500" style="margin-top:3px"><% if mode == "epci" %><%= enjeu_epci_text(i) %><% else %><%= enjeu_position_text(i, r) %><%= n ? " · #{fmt_count(n)} #{unit_pl}" : "" %><% end %><%= ref ? " · #{ref_label} #{fmt_v.(i, ref)}" : "" %></div>
              <% else %>
                <span class="text-xs text-gray-400"><%= ep ? "EPCI non classé" : "commune non classée" %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <p class="text-xs text-gray-500" style="margin-top:8px">
      <button type="button" data-action="click->dashboard-tabs#showTab" data-tab="fragility" style="color:#4f46e5">Voir la synthèse de tous les enjeux</button>
    </p>
  </section>
<% end %>
