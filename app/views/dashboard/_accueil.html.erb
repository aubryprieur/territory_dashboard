<!-- app/views/dashboard/_accueil.html.erb -->
<div class="bg-white/70 backdrop-blur-md rounded-2xl shadow-xl border border-white/20 p-8">

  <!-- En-tête d'accueil -->
  <div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-full mb-4">
      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
      </svg>
    </div>
    <h2 class="text-3xl font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent mb-4">
      Bienvenue sur le Dashboard Commune
    </h2>
    <p class="text-gray-600 text-lg">
      <%= @basic_info[:commune_name] %>
    </p>
  </div>

  <!-- Présentation générale -->
  <div class="max-w-3xl mx-auto mb-8">
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl p-6 border border-blue-100">
      <p class="text-gray-700 leading-relaxed text-center">
        Ce tableau de bord vous permet d'explorer les données territoriales détaillées de votre commune.
        Découvrez les statistiques démographiques, économiques et sociales pour mieux comprendre
        <strong class="text-indigo-600">votre territoire</strong>.
      </p>
    </div>
  </div>

  <!-- Informations clés de la commune -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl mx-auto mb-8">
    <!-- Code INSEE -->
    <div class="bg-gradient-to-br from-indigo-50 to-indigo-100 rounded-xl p-6 border border-indigo-200 hover:shadow-lg transition-shadow duration-300">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Code INSEE</h3>
        <div class="p-2 bg-indigo-200 rounded-lg">
          <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path>
          </svg>
        </div>
      </div>
      <p class="text-4xl font-bold text-gray-900 mb-1">
        <%= @basic_info[:territory_code] %>
      </p>
      <p class="text-sm text-gray-600">identifiant territorial</p>
    </div>

    <!-- Population -->
    <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-xl p-6 border border-green-200 hover:shadow-lg transition-shadow duration-300">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Population</h3>
        <div class="p-2 bg-green-200 rounded-lg">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
        </div>
      </div>
      <p class="text-4xl font-bold text-gray-900 mb-1">
        <% if @basic_info[:population] && @basic_info[:population] > 0 %>
          <%= number_with_delimiter(@basic_info[:population]) %>
        <% else %>
          -
        <% end %>
      </p>
      <p class="text-sm text-gray-600">habitants</p>
    </div>
  </div>

  <!-- Navigation rapide vers les sections -->
  <div class="bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 rounded-2xl p-8 border border-indigo-100">
    <div class="text-center mb-8">
      <h3 class="text-xl font-bold text-gray-900 mb-2">Explorer les données du territoire</h3>
      <p class="text-gray-600">Cliquez sur une section pour accéder aux données détaillées</p>
    </div>

    <div class="mb-6">
      <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Population et familles</h4>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
        <!-- Population -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="synthese"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-indigo-300 hover:scale-105">
          <div class="p-3 bg-indigo-100 rounded-lg group-hover:bg-indigo-200 transition-colors">
            <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-indigo-600 transition-colors text-center">Population</span>
          <span class="text-xs text-gray-500 text-center">Démographie</span>
        </button>

        <!-- Familles -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="families"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-pink-300 hover:scale-105">
          <div class="p-3 bg-pink-100 rounded-lg group-hover:bg-pink-200 transition-colors">
            <svg class="w-6 h-6 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-pink-600 transition-colors text-center">Familles</span>
          <span class="text-xs text-gray-500 text-center">Types de familles</span>
        </button>

        <!-- Ménages -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="households"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-pink-300 hover:scale-105">
          <div class="p-3 bg-pink-100 rounded-lg group-hover:bg-pink-200 transition-colors">
            <svg class="w-6 h-6 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-pink-600 transition-colors text-center">Ménages</span>
          <span class="text-xs text-gray-500 text-center">Composition & isolement</span>
        </button>

        <!-- Logement -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="housing"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-yellow-300 hover:scale-105">
          <div class="p-3 bg-yellow-100 rounded-lg group-hover:bg-yellow-200 transition-colors">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-yellow-600 transition-colors text-center">Logement</span>
          <span class="text-xs text-gray-500 text-center">Parc, statut, suroccupation</span>
        </button>

        <!-- Immigrés et étrangers -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="immigration"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-purple-300 hover:scale-105">
          <div class="p-3 bg-purple-100 rounded-lg group-hover:bg-purple-200 transition-colors">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-purple-600 transition-colors text-center">Immigrés et étrangers</span>
          <span class="text-xs text-gray-500 text-center">Population, emploi</span>
        </button>
      </div>
    </div>
    <div class="mb-6">
      <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Enfance et éducation</h4>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
        <!-- Enfants -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="children_comparison"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-yellow-300 hover:scale-105">
          <div class="p-3 bg-yellow-100 rounded-lg group-hover:bg-yellow-200 transition-colors">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" stroke-width="2"/>
            <circle cx="9" cy="10" r="1.5" fill="currentColor"/>
            <circle cx="15" cy="10" r="1.5" fill="currentColor"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 15s1.5 2 4 2 4-2 4-2"/>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-yellow-600 transition-colors text-center">Enfants</span>
          <span class="text-xs text-gray-500 text-center">Petite enfance</span>
        </button>

        <!-- Garde d'enfants -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="childcare"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-purple-300 hover:scale-105">
          <div class="p-3 bg-purple-100 rounded-lg group-hover:bg-purple-200 transition-colors">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-purple-600 transition-colors text-center">Garde d'enfants</span>
          <span class="text-xs text-gray-500 text-center">Accueil & garde</span>
        </button>

        <!-- Scolarisation -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="schooling"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-blue-300 hover:scale-105">
          <div class="p-3 bg-blue-100 rounded-lg group-hover:bg-blue-200 transition-colors">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-blue-600 transition-colors text-center">Scolarisation</span>
          <span class="text-xs text-gray-500 text-center">Éducation</span>
        </button>

        <!-- Diplômes -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="diplomas"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-blue-300 hover:scale-105">
          <div class="p-3 bg-blue-100 rounded-lg group-hover:bg-blue-200 transition-colors">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M12 14l9-5-9-5-9 5 9 5z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-blue-600 transition-colors text-center">Diplômes</span>
          <span class="text-xs text-gray-500 text-center">Niveau de formation</span>
        </button>

        <!-- Éducation nationale -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="schools"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-blue-300 hover:scale-105">
          <div class="p-3 bg-blue-100 rounded-lg group-hover:bg-blue-200 transition-colors">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-blue-600 transition-colors text-center">Éducation nationale</span>
          <span class="text-xs text-gray-500 text-center">IPS, valeur ajoutée</span>
        </button>
      </div>
    </div>
    <div class="mb-6">
      <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Emploi et ressources</h4>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
        <!-- Emploi -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="employment"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-rose-300 hover:scale-105">
          <div class="p-3 bg-rose-100 rounded-lg group-hover:bg-rose-200 transition-colors">
            <svg class="w-6 h-6 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-rose-600 transition-colors text-center">Emploi</span>
          <span class="text-xs text-gray-500 text-center">Activité, chômage, mobilité</span>
        </button>

        <!-- Tissu économique -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="local_economy"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-emerald-300 hover:scale-105">
          <div class="p-3 bg-emerald-100 rounded-lg group-hover:bg-emerald-200 transition-colors">
            <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-emerald-600 transition-colors text-center">Tissu économique</span>
          <span class="text-xs text-gray-500 text-center">Emplois, établissements</span>
        </button>

        <!-- Revenus et pauvreté -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="revenues_poverty"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-yellow-300 hover:scale-105">
          <div class="p-3 bg-yellow-100 rounded-lg group-hover:bg-yellow-200 transition-colors">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-yellow-600 transition-colors text-center">Revenus et pauvreté</span>
          <span class="text-xs text-gray-500 text-center">Niveau de vie, inégalités</span>
        </button>

        <!-- Prestations CAF -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="caf_benefits"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-green-300 hover:scale-105">
          <div class="p-3 bg-green-100 rounded-lg group-hover:bg-green-200 transition-colors">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-green-600 transition-colors text-center">Prestations CAF</span>
          <span class="text-xs text-gray-500 text-center">RSA, logement, familles</span>
        </button>
      </div>
    </div>
    <div class="mb-6">
      <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Sécurité</h4>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
        <!-- Violences -->
        <button data-dashboard-tabs-target="tab"
                data-action="click->dashboard-tabs#showTab"
                data-tab="domestic_violence"
                class="group flex flex-col items-center space-y-2 px-4 py-4 bg-white rounded-xl hover:shadow-lg transition-all duration-300 border border-gray-200 hover:border-red-300 hover:scale-105">
          <div class="p-3 bg-red-100 rounded-lg group-hover:bg-red-200 transition-colors">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
          <span class="text-sm font-semibold text-gray-700 group-hover:text-red-600 transition-colors text-center">Violences</span>
          <span class="text-xs text-gray-500 text-center">Violences intrafamiliales</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Section d'aide / Conseils -->
  <div class="mt-12 max-w-3xl mx-auto">
    <div class="bg-gradient-to-r from-amber-50 to-orange-50 rounded-xl p-6 border border-amber-200">
      <div class="flex items-start space-x-4">
