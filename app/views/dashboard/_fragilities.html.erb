<%#
  Tableau d'indicateurs de l'Observatoire interrégimes des situations de fragilité sur les 5 territoires.
  Un seul millésime (2025 ; APL 2024), valeurs publiées.
  locals : title, definition (optionnel), rows : [[clé, libellé, :worse_if_higher | :worse_if_lower | :neutral, format]]
           (format : :pct par défaut, :decimal pour l'APL, :score, :count, :signed_pct), note (optionnel),
           dataset : :fragilities (API /fragilities/*, défaut) ou :senior_fragilities (API /senior-fragilities/*),
           show_source : false pour ne pas répéter la source sous chaque tableau (onglet Seniors)
%>
<%
  definition ||= nil
  note ||= nil
  dataset ||= :fragilities
  show_source = true if local_assigns[:show_source].nil?
  fr_apl = rows.any? { |r| r[0].to_s.start_with?("apl_") }
  fr_key = "#{dataset}_data"
  fr_main = instance_variable_get("@#{dataset}_data")
  fr_territories = comparison_territories(fr_key, {
    commune: fr_main, epci: instance_variable_get("@epci_#{dataset}_data"),
    department: instance_variable_get("@department_#{dataset}_data"),
    region: instance_variable_get("@region_#{dataset}_data"), france: instance_variable_get("@france_#{dataset}_data")
  }, france_name: fr_apl ? "France métropolitaine" : "France")
  fr_commune = fr_territories.find { |t| t[:key] == :commune }
  fr_france = fr_territories.find { |t| t[:key] == :france }
%>
<% if fr_commune %>
  <% fr_year = comparison_latest_year(fr_main, comparison_years(fr_main, fr_key)) %>
  <section style="margin-bottom:2.5rem">
    <h3 class="text-base font-medium text-gray-900 mb-1"><%= title %></h3>
    <% if definition %><p class="text-xs text-gray-500 mb-4"><%= definition %> En rouge, une situation moins favorable qu'en France.</p><% end %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Indicateur</th>
            <% fr_territories.each do |t| %>
              <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t[:name] %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% rows.each do |key, label, direction, format| %>
            <% fv = fr_france && territory_value(fr_france, fr_year, key) %>
            <tr>
              <td class="px-4 py-2 text-sm text-gray-900"><%= label %></td>
              <% fr_territories.each do |t| %>
                <%
                  v = territory_value(t, fr_year, key)
                  worse = t[:key] == :commune && direction != :neutral && fv && v && (direction == :worse_if_lower ? v < fv : v > fv)
                %>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-right <%= t[:key] == :commune ? 'font-semibold' : 'text-gray-600' %>" style="<%= worse ? 'color:#b91c1c' : '' %>">
                  <% if v.nil? %><span class="text-gray-400" title="Secret statistique : effectif trop faible">s</span><% elsif format == :decimal %><%= fmt_decimal(v, precision: 1) %><% elsif format == :score %><%= fmt_decimal(v, precision: 2) %><% elsif format == :count %><%= fmt_count(v) %><% elsif format == :signed_pct %><%= v.positive? ? "+" : "" %><%= fmt_pct(v) %><% else %><%= fmt_pct(v) %><% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if show_source %>
    <p class="text-xs text-gray-500 mt-2">Source : Observatoire interrégimes des situations de fragilité (Assurance maladie, Assurance retraite, MSA)<%= dataset == :senior_fragilities ? ", interrégime" : "" %>, <%= fr_year %><%= note ? " ; #{note}" : "" %>. s : secret statistique (effectif trop faible dans la commune).<%= fr_apl ? " France métropolitaine : valeur publiée par l'ANCT." : " France : valeur nationale publiée par l'Observatoire (France entière, outre-mer compris)." %></p>
    <% end %>
  </section>
<% end %>
