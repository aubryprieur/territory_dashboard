<%#
  Bloc indicateur générique : carte de synthèse + tableau (territoires x millésimes)
  + graphique d'évolution. Utilise TerritoryComparisonHelper.

  locals :
    territories  - comparison_territories(...) (la commune en premier ; tableau de bord EPCI : l'EPCI, main)
                   En mode EPCI, une carte repliée compare les communes membres (EpciCommunesHelper).
    years, latest, comparison - millésimes ("2012", "2017", "2023"), dernier, comparaison
    title        - titre du bloc
    theme        - couleur Tailwind de la carte : "indigo" | "purple" | "blue" | "teal" ...
    value_key    - clé de l'indicateur dans les données
    value_format - :pct (défaut, écarts en points), :points (écart déjà en points, 1 décimale),
                   :euros (montant en euros, écart en euros)
                   ou :decimal (écarts en valeur)
    unit         - unité affichée après une valeur décimale (ex. "pers.")
    table_years  - millésimes affichés dans le tableau (défaut : tous ; le graphique garde tous les millésimes)
    decimals     - nombre de décimales des valeurs :decimal (défaut 2 ; 1 pour :points)
    count_key    - effectif à afficher sous la valeur (optionnel)
    total_key    - dénominateur à afficher "x sur y" (optionnel)
    count_label  - libellé de l'effectif (ex. "ménages")
    definition   - phrase d'explication (optionnel ; sinon config/indicator_notes.yml)
    note         - clé du catalogue config/indicator_notes.yml (optionnel ; défaut : value_key, puis titre)
    details      - [{ label:, count_key:, share_key:, euros_key: }] (optionnel ; euros_key : montant en €)
  Affichage : carte du chiffre clé (avec repère France) à gauche ; à droite, bascule Graphique / Tableau (graphique par
  défaut, tableau seul s'il n'y a qu'un millésime) ; définition repliable (ⓘ Définition).
%>
<%
  value_format ||= :pct
  unit ||= nil
  count_key ||= nil
  total_key ||= nil
  count_label ||= ""
  definition ||= nil
  details ||= []
  commune = territories.first
  unit = "pts" if value_format == :points && unit.nil?
  decimals ||= nil
  table_years ||= years
  precision = decimals || (value_format == :points ? 1 : 2)
  fmt_value = lambda do |v|
    case value_format
    when :pct then fmt_pct(v)
    when :euros then v.nil? ? "–" : "#{fmt_count(v)} €"
    else v.nil? ? "–" : "#{fmt_decimal(v, precision: precision)} #{unit}".strip
    end
  end
  trend = lambda do |a, b|
    case value_format
    when :pct, :points then fmt_trend(a, b)            # évolution en points, 1 décimale
    when :euros then fmt_trend(a, b, unit: :euros)
    else fmt_trend(a, b, unit: :value, precision: precision, suffix: (unit if unit.to_s.length <= 5))  # unité courte : km, min
    end
  end
  value = territory_value(commune, latest, value_key)
  single_year = comparison.to_s == latest.to_s  # un seul millésime : ni évolution, ni courbe
  count = count_key && territory_value(commune, latest, count_key)
  total = total_key && territory_value(commune, latest, total_key)
  # Repère France : valeur et rapport (« 2,1 fois plus qu'en France ») pour les taux et valeurs positives
  ref_t = territories.find { |t| t[:key] == :france }
  ref_v = ref_t && territory_value(ref_t, latest, value_key)
  ref_text = if ref_v && value && ref_v.to_f.positive? && value_format != :points
               r = value.to_f / ref_v
               cmp = if r >= 1.2 then "ici #{fmt_decimal(r, precision: 1)} fois plus"
                     elsif r <= 0.83 && r.positive? then "ici #{fmt_decimal(1 / r, precision: 1)} fois moins"
                     else "niveau proche"
                     end
               "#{display_territory_name(ref_t[:name])} : #{fmt_value.(ref_v)} · #{cmp}"
             end
  view_btn = "padding:3px 10px;font-size:12px;border:1px solid #c7d2fe;cursor:pointer"
  view_toggle = "var b=this,s=b.closest('section');s.querySelectorAll('[data-view]').forEach(function(e){e.style.display=e.getAttribute('data-view')===b.getAttribute('data-mode')?'':'none'});s.querySelectorAll('button[data-view-btn]').forEach(function(x){var on=x===b;x.style.background=on?'#4f46e5':'#fff';x.style.color=on?'#fff':'#3730a3'});window.dispatchEvent(new Event('resize'))"
%>
<%
  # Export Excel : taux pour les 5 échelles et tous les millésimes ; effectif et total pour la commune
  unit_label = case value_format when :pct then "%" when :points then "points" when :euros then "€" else unit.to_s end
  xlsx_rows = [["Niveau", "Territoire", "Année", "#{title}#{unit_label.present? ? " (#{unit_label})" : ""}",
                "Effectif (commune)", "Total (commune)"]]
  territories.each do |t|
    years.each do |y|
      v = territory_value(t, y, value_key)
      next if v.nil?
      is_commune = t[:main]
      xlsx_rows << [xlsx_level(t), t[:name], y.to_i, xlsx_number(v),
                    (is_commune && count_key ? xlsx_number(territory_value(t, y, count_key)) : nil),
                    (is_commune && total_key ? xlsx_number(territory_value(t, y, total_key)) : nil)]
    end
  end
  xlsx_notes = [title, definition, (count_label.present? ? "Effectif : #{count_label}" : nil),
                "Commune, EPCI, département, région, France : valeur de l'indicateur ; effectif et total donnés pour la commune."]
%>
<section style="margin-bottom:2.5rem">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px">
    <h3 class="text-sm font-medium text-gray-700 mb-1"><%= title %> (<%= latest %>)</h3>
    <%= xlsx_download_button(filename: xlsx_filename(title), notes: xlsx_notes,
                             sheets: [{ name: "Données", rows: xlsx_rows, widths: [14, 42, 8, 22, 18, 16] }]) %>
  </div>
  <%= indicator_notes(local_assigns[:note], value_key, title, definition: definition, years: years) %>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-4">
    <div class="md:col-span-1">
      <div class="bg-<%= theme %>-50 p-4 rounded-md h-full">
        <h4 class="font-medium text-<%= theme %>-800"><%= title %></h4>
        <div class="flex items-baseline mt-2">
          <p class="text-2xl font-bold text-<%= theme %>-900"><%= value_format == :pct ? fmt_pct(value, precision: decimals || 1) : fmt_value.(value) %></p>
          <% unless single_year %><p class="ml-2"><%= trend.(territory_value(commune, comparison, value_key), value) %></p><% end %>
        </div>
        <% unless single_year %><p class="text-xs text-gray-500">depuis <%= comparison %></p><% end %>
        <% if ref_text %><p class="text-xs text-gray-600" style="margin-top:4px"><%= ref_text %></p><% end %>
        <% if count %>
          <p class="text-sm text-<%= theme %>-700 mt-2">
            <%= fmt_count(count) %><% if total %> sur <%= fmt_count(total) %><% end %> <%= count_label %><%= small_count_flag(count) %>
          </p>
        <% end %>
        <% if details.any? %>
          <div class="mt-3 space-y-1">
            <% details.each do |d| %>
              <% next if d[:euros_key] && territory_value(commune, latest, d[:euros_key]).nil? %>
              <% d_count = d[:count_key] && territory_value(commune, latest, d[:count_key]) %>
              <div class="flex items-baseline justify-between">
                <p class="text-xs text-<%= theme %>-600"><%= d[:label] %></p>
                <p class="text-xs text-<%= theme %>-700 font-medium">
                  <% if d_count %><%= fmt_count(d_count) %><% end %>
                  <% if d[:share_key] %><%= d_count ? "(" : "" %><%= fmt_pct(territory_value(commune, latest, d[:share_key])) %><%= d_count ? ")" : "" %><% end %>
                  <% if d[:euros_key] %><% e = territory_value(commune, latest, d[:euros_key]) %><%= e.nil? ? "–" : "#{fmt_count(e)} €" %><% end %>
                  <%= small_count_flag(d_count) %>
                </p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="md:col-span-2">
      <% unless single_year %>
        <div style="display:flex;justify-content:flex-end;margin-bottom:6px">
          <div style="display:inline-flex;border-radius:8px;overflow:hidden">
            <button type="button" data-view-btn data-mode="chart" onclick="<%= view_toggle %>" style="<%= view_btn %>;border-radius:8px 0 0 8px;background:#4f46e5;color:#fff">Graphique</button>
            <button type="button" data-view-btn data-mode="table" onclick="<%= view_toggle %>" style="<%= view_btn %>;border-left:none;border-radius:0 8px 8px 0;background:#fff;color:#3730a3">Tableau</button>
          </div>
        </div>
        <div data-view="chart">
          <%= comparison_line_chart(territories, years, value_key, unit: (value_format == :pct ? "%" : (value_format == :euros ? "€" : unit.to_s)),
                                    digits: (decimals if value_format == :decimal)) %>
        </div>
      <% end %>
      <div class="overflow-x-auto" data-view="table" style="<%= single_year ? '' : 'display:none' %>">
        <table data-xlsx-skip class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Territoire</th>
              <% table_years.each do |y| %>
                <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= y %></th>
              <% end %>
              <% unless single_year %><th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= comparison %>→<%= latest %></th><% end %>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% territories.each do |t| %>
              <tr>
                <td class="px-4 py-3 whitespace-nowrap text-sm <%= t[:main] ? 'font-medium' : '' %> text-gray-900" title="<%= t[:name] %>">
                  <%= territory_dot(t) %><%= display_territory_name(t[:name]) %>
                </td>
                <% table_years.each do |y| %>
                  <td class="px-3 py-3 whitespace-nowrap text-sm text-right <%= y == latest ? 'font-semibold text-gray-900' : 'text-gray-600' %>">
                    <%= fmt_value.(territory_value(t, y, value_key)) %>
                  </td>
                <% end %>
                <% unless single_year %>
                  <td class="px-3 py-3 whitespace-nowrap text-right">
                    <%= trend.(territory_value(t, comparison, value_key), territory_value(t, latest, value_key)) %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

<%= indicator_source_note %>
</section>
<% communes_map = true if local_assigns[:communes_map].nil? %>
<% if @epci_mode && communes_map %>
  <%# Tableau de bord EPCI : carte de comparaison des communes membres, repliée (communes_map: false si la carte est
      affichée ailleurs dans l'onglet) %>
  <%= render "dashboard/iris_map", map: epci_indicator_map(territories, value_key, title: title, value_format: value_format,
                                                           years: [comparison, latest]),
        level: :communes, collapsed: true, definition: definition %>
<% end %>
