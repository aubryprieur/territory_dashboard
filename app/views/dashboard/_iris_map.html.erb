<%#
  Carte IRIS d'un indicateur (API /iris/map/commune/{code}?indicator=…) : carte sur fond Plan IGN (Leaflet, contrôleur
  Stimulus grid-map, construite à son arrivée à l'écran) colorée selon l'écart de
  chaque IRIS à la commune, et, à droite, tableau des 5 IRIS les plus élevés et des 5 plus faibles (tous au-delà de 12 IRIS : sinon liste complète). N'apparaît que si la commune compte au
  moins deux IRIS.
  locals : map (réponse de l'API, ou nil), definition (optionnel),
           commune_latest (optionnel) : { year:, value:, count:, total: } chiffre communal le plus récent, affiché
           dans la note quand son millésime diffère du dernier millésime IRIS
           level (optionnel) : :communes pour la carte des communes d'un EPCI (tableau de bord EPCI : même rendu,
           libellés « commune » / « EPCI » au lieu de « IRIS » / « commune »)
           collapsed (optionnel) : true pour replier la carte derrière un bouton « Voir la carte par quartier » ;
           :panel pour un panneau masqué piloté par _map_group (plusieurs cartes, boutons accolés)
%>
<% definition ||= nil %>
<% commune_latest ||= nil %>
<% collapsed ||= false %>
<% level ||= :iris %>
<%
  # Libellés selon le niveau : quartiers (IRIS) d'une commune, ou communes d'un EPCI
  lv = if level == :communes
         { unit: "commune", units: "communes", the_unit: "la commune", name_of: "la commune", ref: "l'EPCI",
           ref_whole: "Ensemble de l'EPCI", ref_sum: "Ensemble de l'EPCI", by: "par commune", code: "commune",
           sheet: "Communes", top: "Les 5 communes", top_suffix: "es", fold: "🗺 Voir la carte des communes", intro: "",
           no_value: "commune sans valeur publiée" }
       else
         { unit: "IRIS", units: "IRIS", the_unit: "l'IRIS", name_of: "l'IRIS", ref: "la commune",
           ref_whole: "Ensemble de la commune", ref_sum: "Commune (somme des IRIS)", by: "par IRIS", code: "IRIS",
           sheet: "IRIS", top: "Les 5 IRIS", top_suffix: "s", fold: "🗺 Voir la carte par quartier (IRIS)",
           intro: " Les IRIS sont les quartiers statistiques de l'Insee (environ 2 000 habitants).",
           no_value: "IRIS sans population concernée" }
       end
%>
<% if map.present? %>
  <%
    years = (map["years"] || []).map(&:to_s)
    latest = years.last
    first = years.first
    unit = map.dig("indicator", "unit")
    reference = map.dig("commune", "values", latest, "value")
    # Classes à seuils (map["breaks"] : 4 seuils croissants) pour les effectifs et les taux de variation, sinon écart
    # relatif à la référence (commune ou EPCI)
    breaks = map["breaks"]
    classify = if breaks
                 ->(v) { v.nil? ? nil : IrisMapHelper::IRIS_CLASSES[breaks.count { |b| v > b }] }
               else
                 ->(v) { iris_class(v, reference) }
               end
    legend_classes = if breaks
                       IrisMapHelper::IRIS_CLASSES.each_with_index.map do |c, i|
                         lo = i.zero? ? nil : breaks[i - 1]
                         hi = breaks[i]
                         range = if lo.nil? then "#{fmt_iris(hi, unit)} ou moins"
                                 elsif hi.nil? then "plus de #{fmt_iris(lo, unit)}"
                                 else "#{fmt_iris(lo, unit)} à #{fmt_iris(hi, unit)}"
                                 end
                         c.merge(range: range)
                       end
                     else
                       iris_legend(reference, unit)
                     end
    features = (map["features"] || []).sort_by { |f| -(iris_value(f, latest) || -1) }
    count_label = map.dig("indicator", "count_label")
    additive = map.dig("indicator", "additive") != false  # sinon : pas d'effectif (médiane, taux publiés tels quels)
    # sur fond de carte, « proche de la commune » en ocre (le sable des anciennes cartes SVG se confondait avec le plan)
    map_color = ->(color) { color == "#f5ede0" ? "#d4b483" : color }
    shapes = features.map do |f|
      value = iris_value(f, latest)
      count = iris_value(f, latest, "count")
      total = iris_value(f, latest, "total")
      cls = classify.(value)
      tip = "<strong>#{ERB::Util.h(f['iris_name'])}</strong> (#{lv[:code]} #{f['iris_code']})<br>#{fmt_iris(value, unit)}"
      tip += "<br>#{fmt_count(count)} sur #{fmt_count(total)}" if count && total && additive
      tip += "<br><em>pas de valeur (#{lv[:no_value]})</em>" if value.nil?
      { geometry: f["geometry"], color: cls ? map_color.(cls[:color]) : IrisMapHelper::IRIS_NO_DATA, tip: tip }
    end
  %>
  <%
    # Export Excel : chaque IRIS et la commune, tous les millésimes, taux + effectif + total
    ilabel = map.dig("indicator", "label")
    iris_rows = [["Code #{lv[:code]}", "Nom de #{lv[:name_of]}", "Année", (unit.present? ? "#{ilabel} (#{unit})" : ilabel), "Effectif", "Total"]]
    (map["features"] || []).sort_by { |f| f["iris_code"].to_s }.each do |f|
      years.each do |y|
        v = f.dig("values", y)
        next if v.nil?
        iris_rows << [f["iris_code"], f["iris_name"], y.to_i, xlsx_number(v["value"]),
                      additive ? xlsx_number(v["count"]) : nil, additive ? xlsx_number(v["total"]) : nil]
      end
    end
    years.each do |y|
      v = map.dig("commune", "values", y) || {}
      iris_rows << [(level == :communes ? "EPCI" : "Commune"), (additive ? lv[:ref_sum] : lv[:ref_whole]), y.to_i,
                    xlsx_number(v["value"]), additive ? xlsx_number(v["count"]) : nil, additive ? xlsx_number(v["total"]) : nil]
    end
    iris_notes = ["#{ilabel} #{lv[:by]}", definition, (additive && count_label ? "Effectif : #{count_label} ; total : dénominateur de #{lv[:the_unit]}" : nil),
                  "Source : #{map['source']}"]
  %>
  <% if collapsed == :panel %><div data-map-panel style="display:none"><% elsif collapsed %><details class="map-fold" style="margin:0 0 2rem"><summary style="cursor:pointer;list-style:none;display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border:1px solid #c7d2fe;border-radius:8px;background:#f8faff;color:#3730a3;font-size:13px;font-weight:500"><%= lv[:fold] %> : <%= ilabel.to_s.sub(/\A./, &:downcase) %></summary><div style="margin-top:12px"><% end %>
  <section style="margin-bottom:2.5rem">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px">
      <h3 class="text-sm font-medium text-gray-700 mb-1"><%= ilabel %> <%= lv[:by] %> (<%= latest %>)</h3>
      <%= xlsx_download_button(filename: xlsx_filename(ilabel, lv[:sheet]), notes: iris_notes,
                               sheets: [{ name: lv[:sheet], rows: iris_rows, widths: [12, 36, 8, 22, 12, 12] }]) %>
    </div>
    <p class="text-xs text-gray-500 mb-4"><%= definition %><%= lv[:intro] %> <%= map["color_note"] || "Couleur : écart de chaque #{lv[:unit]} à l'ensemble de #{lv[:ref]} (#{fmt_iris(reference, unit)} en #{latest})." %></p>
    <style>
      .iris-layout{display:grid;grid-template-columns:1fr;gap:1.5rem;align-items:start}
      @media (min-width:900px){.iris-layout{grid-template-columns:3fr 2fr}}
    </style>
    <div class="iris-layout">
      <!-- Carte (fond Plan IGN) -->
      <div data-controller="grid-map" data-grid-map-data-value="<%= { shapes: shapes }.to_json %>">
        <div data-grid-map-target="map" style="height:420px;border-radius:12px;border:1px solid #e2e8f0;overflow:hidden;z-index:0;position:relative;background:#f8fafc"></div>
        <!-- Légende : barre segmentée, du plus faible au plus élevé -->
        <div class="mt-3">
          <div style="display:flex;gap:3px">
            <% legend_classes.each do |c| %>
              <div style="flex:1;min-width:0">
                <div style="height:10px;border-radius:999px;background:<%= map_color.(c[:color]) %>"></div>
                <div class="text-gray-500" style="font-size:10px;line-height:1.2;margin-top:4px;text-align:center"><%= c[:range] %></div>
              </div>
            <% end %>
          </div>
          <div class="flex items-center justify-between mt-2" style="font-size:11px">
            <span class="text-gray-500">← <%= map["legend_low"] || "Inférieur à #{lv[:ref]}" %></span>
            <span class="inline-flex items-center text-gray-500"><span style="display:inline-block;width:10px;height:10px;border-radius:3px;background:<%= IrisMapHelper::IRIS_NO_DATA_SWATCH %>;margin-right:4px"></span>Sans valeur</span>
            <span class="text-gray-500"><%= map["legend_high"] || "Supérieur à #{lv[:ref]}" %> →</span>
          </div>
        </div>
        <div class="text-xs text-gray-500 mt-1" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
          <span>Survoler <%= level == :communes ? "une commune" : "un IRIS" %> pour son nom, son code et sa valeur ; cliquer sur la carte pour zoomer à la molette.</span>
          <label style="display:flex;align-items:center;gap:6px">Opacité
            <input type="range" min="0.1" max="0.9" step="0.1" value="0.7" data-action="input->grid-map#opacity" style="width:100px">
          </label>
        </div>
      </div>

      <!-- Tableau : 5 IRIS les plus élevés, 5 les plus faibles, commune -->
      <div>
        <%
          ranked = features.reject { |f| iris_value(f, latest).nil? }  # IRIS sans valeur : sur la carte seulement
          split = ranked.size > 12
          groups = split ? [["#{lv[:top]} les plus élevé#{lv[:top_suffix]}", ranked.first(5)], ["#{lv[:top]} les plus faibles", ranked.last(5).reverse]] : [[nil, ranked]]
          two_years = first != latest
          ncols = 2 + (two_years ? 1 : 0) + (additive ? 1 : 0)
          th = "px-2 py-2 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"
          td = "px-2 py-2 whitespace-nowrap text-xs text-right"
        %>
        <table data-xlsx-skip class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-2 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= level == :communes ? "Commune" : "IRIS" %></th>
              <th class="<%= th %>"><%= latest %></th>
              <% if two_years %><th class="<%= th %>">Depuis <%= first %></th><% end %>
              <% if additive %><th class="<%= th %>">Effectif</th><% end %>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% groups.each do |label, list| %>
              <% if label %>
                <tr><td colspan="<%= ncols %>" class="px-2 pt-3 text-xs font-semibold text-gray-700"><%= label %></td></tr>
              <% end %>
              <% list.each do |f| %>
                <%
                  values = f["values"] || {}
                  v1 = values.dig(latest, "value"); v0 = values.dig(first, "value")
                  cls = classify.(v1)
                %>
                <tr>
                  <td class="px-2 py-2 text-xs text-gray-900">
                    <span style="display:inline-block;width:9px;height:9px;border-radius:999px;background:<%= cls ? map_color.(cls[:color]) : IrisMapHelper::IRIS_NO_DATA_SWATCH %>;margin-right:6px;vertical-align:middle"></span><%= f["iris_name"] %>
                  </td>
                  <td class="<%= td %> font-medium"><%= fmt_iris(v1, unit) %></td>
                  <% if two_years %><td class="<%= td %> text-gray-600"><%= iris_trend(v0, v1, unit) %></td><% end %>
                  <% if additive %><td class="<%= td %> text-gray-600"><%= values.dig(latest, "count") ? "#{fmt_count(values.dig(latest, 'count'))} / #{fmt_count(values.dig(latest, 'total'))}" : "–" %></td><% end %>
                </tr>
              <% end %>
            <% end %>
            <% cv = map.dig("commune", "values") || {} %>
            <tr class="bg-gray-50 font-semibold">
              <td class="px-2 py-2 text-xs text-gray-900"><%= additive ? lv[:ref_sum] : lv[:ref_whole] %></td>
              <td class="<%= td %>"><%= fmt_iris(cv.dig(latest, "value"), unit) %></td>
              <% if two_years %><td class="<%= td %> text-gray-600"><%= iris_trend(cv.dig(first, "value"), cv.dig(latest, "value"), unit) %></td><% end %>
              <% if additive %><td class="<%= td %> text-gray-600"><%= cv.dig(latest, "count") ? "#{fmt_count(cv.dig(latest, 'count'))} / #{fmt_count(cv.dig(latest, 'total'))}" : "–" %></td><% end %>
            </tr>
          </tbody>
        </table>
        <% if split %><p class="text-xs text-gray-500 mt-2"><%= ranked.size - 10 %> autres <%= lv[:units] %> sur la carte.</p><% end %>
        <% if additive %><p class="text-xs text-gray-500 mt-1">Effectif : <%= count_label %> / total de <%= lv[:the_unit] %>.</p><% end %>
        <% if commune_latest && commune_latest[:year].to_s != latest.to_s %>
          <p class="text-xs text-gray-600 mt-2 bg-gray-50 border border-gray-200 rounded p-2">Dernier millésime à l'IRIS : <%= latest %>. Chiffre communal affiché plus haut : <%= commune_latest[:year] %> (<%= fmt_iris(commune_latest[:value], unit) %><% if commune_latest[:count] && commune_latest[:total] %>, soit <%= fmt_count(commune_latest[:count]) %> sur <%= fmt_count(commune_latest[:total]) %><% end %>).<% if additive && two_years %> Même valeur pour un même millésime (<%= first %> : <%= fmt_iris(cv.dig(first, "value"), unit) %>).<% end %></p>
        <% end %>
        <p class="text-xs text-gray-500 mt-2">Source : <%= map["source"] %> (<%= years.join(" et ") %>) ; fond de carte : Plan IGN (Géoplateforme).</p>
      </div>
    </div>
  </section>
  <% if collapsed == :panel %></div><% elsif collapsed %></div></details><% end %>
<% end %>
