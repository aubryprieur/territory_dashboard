<%#
  Onglet Diplômes et formation — dashboard commune (analyse des besoins sociaux).
  Données : INSEE, recensements 2012, 2017, 2023 (API /education-training/*).
  Champ : population de 15 ans ou plus non scolarisée, selon le diplôme le plus élevé.
%>
<%
  territories = comparison_territories("education_data", {
    commune: @education_data, epci: @epci_education_data, department: @department_education_data,
    region: @region_education_data, france: @france_education_data
  })
  years = comparison_years(@education_data, "education_data")
  latest = comparison_latest_year(@education_data, years)
  comparison = comparison_start_year(@education_data, years)
  commune = territories.first
  common = { territories: territories, years: years, latest: latest, comparison: comparison }
%>
<div class="bg-white shadow rounded-lg p-6 mb-6">
  <h2 class="text-lg font-medium text-gray-900 mb-1">Diplômes et formation</h2>
  <p class="text-xs text-gray-500 mb-4">Diplôme le plus élevé de la population de 15 ans ou plus <strong>non scolarisée</strong> (les élèves et étudiants ne sont pas comptés).</p>

  <% if commune.nil? || commune[:key] != :commune %>
    <p class="text-sm text-gray-500">Données diplômes indisponibles pour ce territoire.</p>
  <% else %>
    <% ev = ->(key, year = latest) { territory_value(commune, year, key) } %>

    <!-- Synthèse -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
      <% [
           ["Sans diplôme ou CEP", "no_diploma_percentage", "no_diploma", "purple"],
           ["Au plus le brevet", "low_qualification_percentage", "low_qualification", "indigo"],
           ["Diplômés du supérieur", "higher_education_percentage", "higher_education", "blue"],
           ["Bac + 3 ou plus", "bac3_plus_percentage", "bac3_plus", "teal"]
         ].each do |label, key, count_key, theme| %>
        <div class="bg-<%= theme %>-50 p-4 rounded-lg">
          <h3 class="text-sm font-medium text-<%= theme %>-800 mb-1"><%= label %></h3>
          <p class="text-2xl font-bold text-<%= theme %>-900"><%= fmt_pct(ev.(key)) %></p>
          <p class="text-xs text-<%= theme %>-700"><%= fmt_count(ev.(count_key)) %> personnes · <%= fmt_trend(ev.(key, comparison), ev.(key)) %> depuis <%= comparison %></p>
        </div>
      <% end %>
    </div>

    <!-- Répartition par niveau de diplôme -->
    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Répartition selon le diplôme le plus élevé (<%= latest %>)</h3>
      <p class="text-xs text-gray-500 mb-4">Population de 15 ans ou plus non scolarisée, en %.</p>
      <%
        levels = [
          ["no_diploma_percentage", "Sans diplôme ou CEP", "#7f1d1d"],
          ["bepc_percentage", "BEPC, brevet", "#ef4444"],
          ["cap_bep_percentage", "CAP, BEP", "#fca5a5"],
          ["bac_percentage", "Bac, brevet pro.", "#e5e7eb"],
          ["bac2_percentage", "Bac + 2", "#93c5fd"],
          ["bac3_plus_percentage", "Bac + 3 ou plus", "#1d4ed8"]
        ]
      %>
      <%= comparison_stacked_chart(territories, latest, levels, "Répartition de la population par diplôme et par territoire") %>

      <div class="overflow-x-auto mt-6">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= @territory_name %></th>
              <% years.each do |y| %>
                <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= y %></th>
              <% end %>
              <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= comparison %>→<%= latest %></th>
              <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">France métro. <%= latest %></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% france = territories.find { |t| t[:key] == :france } %>
            <% (levels.first(5) + [["bac3_4_percentage", "dont bac + 3 ou 4"], ["bac5_plus_percentage", "dont bac + 5 ou plus"]].unshift(levels.last)).each do |key, label, _| %>
              <% sub = label.start_with?("dont") %>
              <tr>
                <td class="px-4 py-2 whitespace-nowrap text-sm <%= sub ? 'text-gray-500' : 'text-gray-900' %>" style="<%= sub ? 'padding-left:2rem' : '' %>"><%= label %></td>
                <% years.each do |y| %>
                  <td class="px-3 py-2 whitespace-nowrap text-sm text-right <%= y == latest ? 'font-semibold text-gray-900' : 'text-gray-600' %>"><%= fmt_pct(ev.(key, y)) %></td>
                <% end %>
                <td class="px-3 py-2 whitespace-nowrap text-right"><%= fmt_trend(ev.(key, comparison), ev.(key)) %></td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-right text-gray-600"><%= france ? fmt_pct(territory_value(france, latest, key)) : "–" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <p class="text-xs text-gray-500 mt-2">Bac + 3 ou 4 et bac + 5 ou plus ne sont distingués par l'INSEE qu'à partir de 2017.</p>
      </div>
    </section>

    <!-- Sans diplôme -->
    <%= render "dashboard/territory_indicator", **common,
          title: "Population sans diplôme ou avec le CEP", theme: "purple",
          value_key: "no_diploma_percentage",
          count_key: "no_diploma", total_key: "non_enrolled_15_plus", count_label: "personnes",
          definition: "Part des 15 ans ou plus non scolarisés n'ayant aucun diplôme ou seulement le certificat d'études primaires. Indicateur clé de fragilité face à l'emploi.",
          details: [
            { label: "Femmes", share_key: "no_diploma_percentage_women" },
            { label: "Hommes", share_key: "no_diploma_percentage_men" }
          ] %>

    <!-- Diplômés du supérieur -->
    <%= render "dashboard/territory_indicator", **common,
          title: "Diplômés de l'enseignement supérieur", theme: "blue",
          value_key: "higher_education_percentage",
          count_key: "higher_education", total_key: "non_enrolled_15_plus", count_label: "personnes",
          definition: "Part des 15 ans ou plus non scolarisés titulaires d'un diplôme de l'enseignement supérieur (bac + 2 ou plus).",
          details: [
            { label: "Femmes", share_key: "higher_education_percentage_women" },
            { label: "Hommes", share_key: "higher_education_percentage_men" }
          ] %>

    <!-- CAP-BEP -->
    <%= render "dashboard/territory_indicator", **common,
          title: "Titulaires d'un CAP ou BEP", theme: "indigo",
          value_key: "cap_bep_percentage",
          count_key: "cap_bep", total_key: "non_enrolled_15_plus", count_label: "personnes",
          definition: "Part des 15 ans ou plus non scolarisés dont le diplôme le plus élevé est un CAP, un BEP ou équivalent (filières professionnelles courtes)." %>

    <div class="mt-6 pt-4 border-t border-gray-200 text-xs text-gray-500 space-y-1">
      <p>Source : INSEE, recensements de la population <%= years.join(", ") %> (géographie au 1er janvier 2026).</p>
      <p>Champ : population de 15 ans ou plus non scolarisée. La part des sans diplôme est plus élevée chez les personnes âgées, ce qui pèse sur les territoires vieillissants.</p>
      <p>Les évolutions sont exprimées en points de pourcentage entre <%= comparison %> et <%= latest %>.</p>
      <p><span style="color:#d97706">⚠</span> Effectif inférieur à 200 : l'INSEE recommande de l'interpréter avec prudence.</p>
    </div>
  <% end %>
</div>
