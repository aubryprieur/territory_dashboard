<%#
  Onglet Population — structure et évolution (analyse des besoins sociaux), organisé en questions :
    1. Combien d'habitants et quelle évolution ? (série 1968-2023, moteurs, densité) 2. Naissances (état civil)
    3. Âge de la population, aujourd'hui et demain (pyramide avec projection 2033, grandes tranches, dépendance)
    4. Nouveaux arrivants
  Données : INSEE, recensements (API /population-structure/*) :
    - structure par âge, pyramide (2023), catégories socioprofessionnelles, mobilité résidentielle (2012, 2017, 2023)
    - série longue 1968 → 2023 (population, solde naturel et solde migratoire)
%>
<%
  territories = comparison_territories("population_data", {
    commune: @pop_data, epci: @epci_pop_data, department: @department_pop_data,
    region: @region_pop_data, france: @france_pop_data
  })
  years = comparison_years(@pop_data, "population_data")
  latest = comparison_latest_year(@pop_data, years)
  comparison = comparison_start_year(@pop_data, years)
  commune = territories.first
  france = territories.find { |t| t[:key] == :france }
  common = { territories: territories, years: years, latest: latest, comparison: comparison }
  labels = @pop_data.is_a?(Hash) ? (@pop_data["labels"] || {}) : {}
  questions = [
    ["q-population-1", "Combien d'habitants, et comment la population évolue-t-elle ?"],
    ["q-population-2", "Combien d'enfants naissent chaque année ?"],
    ["q-population-3", "Quel âge a la population, aujourd'hui et demain ?"],
    ["q-population-4", "Qui arrive dans la commune ?"]
  ]
%>
<% if commune.nil? || !commune[:main] %>
  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <h2 class="text-lg font-medium text-gray-900 mb-1">Population</h2>
    <p class="text-sm text-gray-500">Données population indisponibles pour ce territoire.</p>
  </div>
<% else %>
  <% pv = ->(key, year = latest) { territory_value(commune, year, key) } %>
  <% history = territory_history(commune) %>
  <% periods = history["periods"] || [] %>
  <% last_period = periods.last || {} %>

  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <h2 class="text-lg font-medium text-gray-900 mb-1">Population</h2>
    <p class="text-xs text-gray-500 mb-4">Population municipale au sens du recensement : quatre questions sur le nombre d'habitants, les naissances, l'âge et les arrivées. Les catégories socioprofessionnelles sont dans l'onglet Emploi ; le détail par âge dans les onglets Petite enfance, Enfance-jeunesse et Seniors.</p>
    <%= story_summary(questions) %>

    <%= render "dashboard/fragility_ranks", tab: "synthese" %>
    <%= story_takeaways("synthese") %>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="bg-indigo-50 p-4 rounded-lg">
        <h3 class="text-sm font-medium text-indigo-800 mb-1">Population <%= latest %></h3>
        <p class="text-2xl font-bold text-indigo-900"><%= fmt_count(pv.("pop")) %></p>
        <p class="text-xs text-indigo-700">
          <% if last_period["annual_growth_rate"] %>
            <%= last_period["annual_growth_rate"] >= 0 ? "+" : "" %><%= number_with_precision(last_period["annual_growth_rate"], precision: 2) %> % par an depuis <%= last_period["start_year"] %>
          <% end %>
        </p>
      </div>
      <% [
           ["Moins de 15 ans", "age_lt15_percentage", "blue"],
           ["65 ans ou plus", "age_ge65_percentage", "purple"],
           ["80 ans ou plus", "age_ge80_percentage", "teal"]
         ].each do |label, key, theme| %>
        <div class="bg-<%= theme %>-50 p-4 rounded-lg">
          <h3 class="text-sm font-medium text-<%= theme %>-800 mb-1"><%= label %></h3>
          <p class="text-2xl font-bold text-<%= theme %>-900"><%= fmt_pct(pv.(key)) %></p>
          <p class="text-xs text-<%= theme %>-700">de la population · <%= fmt_trend(pv.(key, comparison), pv.(key)) %> depuis <%= comparison %></p>
        </div>
      <% end %>
    </div>

  </div>

  <%= story_card("q-population-1", 1, "Combien d'habitants, et comment la population évolue-t-elle ?",
        "Évolution depuis 1968, part du solde naturel (naissances moins décès) et du solde migratoire (arrivées moins départs), densité.") do %>
    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Population en base 100 en 1968</h3>
      <%= indicator_notes("population_structure__population_en_base_100_en_1968", years: "1968 à #{latest}") do %>Indice 100 = population de 1968 de chaque territoire : permet de comparer les dynamiques quelle que soit la taille.<% end %>
      <%= history_index_chart(territories) %>
      <%= indicator_source_note %>
    </section>

    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Moteurs de l'évolution à <%= commune[:name] %></h3>
      <%= indicator_notes("population_structure__moteurs_de_l_evolution_a", years: "1968 à #{latest}") do %>Taux de variation annuel moyen de la population, décomposé entre le solde naturel (naissances moins décès) et le solde migratoire apparent (arrivées moins départs), en % par an.<% end %>
      <%= history_components_chart(commune) %>
      <div class="overflow-x-auto mt-6">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <% ["Période", "Population en fin de période", "Variation", "Var. annuelle", "dont solde naturel", "dont solde migratoire", "Natalité (‰)", "Mortalité (‰)"].each_with_index do |h, i| %>
                <th scope="col" class="px-3 py-3 <%= i.zero? ? 'text-left' : 'text-right' %> text-xs font-medium text-gray-500 uppercase tracking-wider"><%= h %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% censuses = (history["censuses"] || []).to_h { |c| [c["year"], c] } %>
            <% signed = ->(v, unit = " %") { v.nil? ? "–" : "#{v.positive? ? '+' : (v.negative? ? '−' : '')}#{number_with_precision(v.abs, precision: 2)}#{unit}" } %>
            <% periods.each do |p| %>
              <tr>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-gray-900"><%= p["period"] %></td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-right"><%= fmt_count(censuses.dig(p["end_year"], "population")) %></td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-right"><%= p["population_change"].nil? ? "–" : "#{p['population_change'].positive? ? '+' : (p['population_change'].negative? ? '−' : '')}#{fmt_count(p['population_change'].abs)}" %></td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-right font-semibold"><%= signed.(p["annual_growth_rate"]) %></td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-right" style="color:#0f766e"><%= signed.(p["annual_natural_rate"]) %></td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-right" style="color:#b45309"><%= signed.(p["annual_migration_rate"]) %></td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-right text-gray-600"><%= p["birth_rate"] ? number_with_precision(p["birth_rate"], precision: 1) : "–" %></td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-right text-gray-600"><%= p["death_rate"] ? number_with_precision(p["death_rate"], precision: 1) : "–" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <p class="text-xs text-gray-500 mt-2">
          Solde migratoire apparent : écart entre la variation de population et le solde naturel (il inclut les ajustements de méthode du recensement).
        </p>
      </div>
      <%= indicator_source_note %>
    </section>

    <% if @epci_mode %>
      <%# Tableau de bord EPCI : habitants et variation annuelle par commune %>
      <%= render "dashboard/map_group", maps: epci_population_maps(commune, latest) %>
    <% end %>

    <%# Quartiers (commune découpée en IRIS) : répartition des habitants, puis évolution %>
    <%= render "dashboard/map_group", maps: [
          { kind: :iris, map: cached_iris_map("pop_share"),
            definition: "Nombre d'habitants de chaque IRIS et part qu'il représente dans la population de la commune : repère les quartiers les plus peuplés." },
          { kind: :iris, map: cached_iris_map("pop_growth"),
            definition: "Taux de variation annuel moyen de la population de chaque IRIS entre les recensements 2017 et 2023 (à l'IRIS, 2018 n'est pas disponible)." }
        ] %>

    <%= render "dashboard/territory_indicator", **common,
          title: "Densité de population", theme: "indigo",
          value_key: "density", value_format: :decimal, unit: "hab./km²", decimals: 0,
          definition: "Nombre d'habitants par km² (superficie actuelle du territoire). Repère pour l'organisation des services : en territoire peu dense, les distances d'accès pèsent davantage." %>

    <%= render "dashboard/iris_map", map: cached_iris_map("density"), collapsed: true,
          definition: "Habitants par km² de chaque IRIS. La surface est celle du contour de l'IRIS, espaces non bâtis compris (zones d'activité, parcs, voies ferrées) : un IRIS étendu mais peu habité paraît peu dense." %>

    <div class="pt-4 border-t border-gray-200 text-xs text-gray-500 space-y-1">
      <p>Source : INSEE, recensements de la population 1968 à <%= latest %> (géographie au 1er janvier 2026). Évolutions en points de pourcentage entre <%= comparison %> et <%= latest %>. <span style="color:#d97706">⚠</span> Effectif inférieur à 200 : à interpréter avec prudence.</p>
    </div>
  <% end %>

  <%= story_card("q-population-2", 2, "Combien d'enfants naissent chaque année ?",
        "Naissances domiciliées depuis 2014, comparées aux autres échelles. Projections des naissances : onglet Petite enfance.") do %>
    <%
      bs = @births_series || {}
      b_main = @epci_mode ? :epci : :commune  # tableau de bord EPCI : série de l'EPCI
      b_years = (bs[b_main].presence || bs[:france] || {}).keys.sort
      b_first, b_last = b_years.first, b_years.last
      b_com = bs[b_main] || {}
    %>

    <% if b_years.size >= 2 && b_com.any? %>
      <%
        b_datasets = territories.filter_map do |t|
          series = bs[t[:key]] || {}
          base = series[b_first]
          next if base.nil? || base.zero?
          { label: t[:name], data: b_years.map { |y| series[y] && (series[y] * 100.0 / base).round(1) }, color: t[:color], main: t[:main] }
        end
        b_avg = (b_com.values.sum / b_com.size).round
        b_change = b_com[b_first].to_f.positive? && b_com[b_last] ? (b_com[b_last] - b_com[b_first]) * 100.0 / b_com[b_first] : nil
      %>
      <section style="margin-bottom:2.5rem">
        <h3 class="text-sm font-medium text-gray-700 mb-1">Naissances en base 100 en <%= b_first %></h3>
        <%= indicator_notes("population_structure__naissances_en_base_100_en", years: "#{b_first} à #{b_last}") do %>Naissances domiciliées (enfants dont la mère réside dans le territoire), indice 100 = naissances de <%= b_first %> de chaque territoire : compare les dynamiques quelle que soit la taille.<%= b_avg < 30 ? " Avec en moyenne #{b_avg} naissances par an, la courbe de la commune varie fortement d'une année à l'autre : regarder la tendance plutôt que chaque année." : "" %><% end %>
        <% if b_datasets.any? %>
          <%= chart_canvas({ type: "line", unit: "", labels: b_years, datasets: b_datasets }, 260, "Évolution des naissances depuis #{b_first} (base 100) par territoire") %>
        <% end %>
        <%= indicator_source_note %>
      </section>

      <section style="margin-bottom:2.5rem">
        <h3 class="text-sm font-medium text-gray-700 mb-1">Naissances à <%= commune[:name] %> (<%= b_first %>-<%= b_last %>)</h3>
        <%= indicator_notes("population_structure__naissances_a", years: "#{b_first} à #{b_last}") %>
        <p class="text-xs text-gray-500 mb-4">
          <%= fmt_count(b_com[b_last]) %> naissances en <%= b_last %><% if b_change %>, <%= b_change.positive? ? "+" : "" %><%= number_with_precision(b_change, precision: 1, separator: ",") %> % par rapport à <%= b_first %><% end %> ; <%= fmt_count(b_avg) %> par an en moyenne sur la période.
        </p>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Année</th>
                <% b_years.each do |y| %><th class="px-2 py-2 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= y %></th><% end %>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <tr>
                <td class="px-3 py-2 text-sm text-gray-900">Naissances</td>
                <% b_years.each do |y| %><td class="px-2 py-2 whitespace-nowrap text-sm text-right font-semibold"><%= b_com[y] ? fmt_count(b_com[y]) : "–" %></td><% end %>
              </tr>
              <tr>
                <td class="px-3 py-2 text-sm text-gray-900">Écart à l'année précédente</td>
                <% b_years.each_with_index do |y, i| %>
                  <% d = i.positive? && b_com[y] && b_com[b_years[i - 1]] ? (b_com[y] - b_com[b_years[i - 1]]).round : nil %>
                  <td class="px-2 py-2 whitespace-nowrap text-sm text-right text-gray-600"><%= d.nil? ? "–" : "#{d.positive? ? '+' : ''}#{fmt_count(d)}" %></td>
                <% end %>
              </tr>
            </tbody>
          </table>
        </div>
        <%= indicator_source_note do %>INSEE, état civil, naissances domiciliées <%= b_first %>-<%= b_last %> ; France : France entière (outre-mer compris).<% end %>
      </section>
    <% end %>
    <% if @epci_mode %>
      <%# Tableau de bord EPCI : naissances de la dernière année par commune %>
      <%= render "dashboard/map_group", maps: [{ kind: :communes, map: epci_births_map(commune),
                                                 definition: "Naissances domiciliées : enfants nés vivants dont la mère réside dans la commune." }] %>
    <% end %>


  <% end %>

  <%= story_card("q-population-3", 3, "Quel âge a la population, aujourd'hui et demain ?",
        "Pyramide des âges (avec la projection 2033), grandes tranches d'âge et rapport de dépendance.") do %>
    <% if pv.("pyr_women_0_4_percentage") %>
      <%
        pyr_groups = (labels["pyramid"] || {}).keys.presence || (0..90).step(5).map { |a| "#{a}_#{a + 4}" } + ["ge95"]
        # Pyramide projetée (API /population-projection/*, scénario tendanciel) : effectifs 2033 en % du total 2033
        pj = @population_projection.is_a?(Hash) && @population_projection["error"].blank? ? @population_projection : nil
        pyr = pj && pj["pyramid"].is_a?(Hash) && pj["pyramid"]["groups"].present? ? pj["pyramid"] : nil
        if pyr
          plabels = labels["pyramid"] || {}
          ptotal = (pyr["men"].to_a + pyr["women"].to_a).sum.to_f
          pshare = ->(sex) { pyr[sex].to_a.map { |v| ptotal.positive? ? (v * 100.0 / ptotal).round(2) : nil } }
          obs = ->(sex) { pyr["groups"].map { |g| territory_value(commune, latest, "pyr_#{sex}_#{g}_percentage") } }
          pconfig = {
            type: "pyramid",
            labels: pyr["groups"].map { |g| plabels[g] || g }.reverse,
            main: { name: "#{commune[:name]} #{latest}", men: obs.("men").reverse, women: obs.("women").reverse },
            reference: { name: "Projection #{pyr['year']}", men: pshare.("men").reverse, women: pshare.("women").reverse }
          }
        end
        pbtn = "padding:4px 10px;font-size:12px;border:1px solid #c7d2fe;cursor:pointer"
        ptoggle = "var b=this,s=b.closest('section');s.querySelectorAll('[data-pyr-mode]').forEach(function(e){e.style.display=e.getAttribute('data-pyr-mode')===b.getAttribute('data-mode')?'':'none'});s.querySelectorAll('button[data-mode]').forEach(function(x){var on=x===b;x.style.background=on?'#4f46e5':'#fff';x.style.color=on?'#fff':'#3730a3'});window.dispatchEvent(new Event('resize'))"
      %>
      <section style="margin-bottom:2.5rem">
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;gap:10px">
          <h3 class="text-sm font-medium text-gray-700 mb-1">Pyramide des âges (<%= latest %>)</h3>
          <% if pyr %>
            <div style="display:inline-flex;border-radius:8px;overflow:hidden">
              <button type="button" data-mode="france" onclick="<%= ptoggle %>" style="<%= pbtn %>;border-radius:8px 0 0 8px;background:#4f46e5;color:#fff">Comparaison <%= france ? france[:name] : "référence" %></button>
              <button type="button" data-mode="projection" onclick="<%= ptoggle %>" style="<%= pbtn %>;border-left:none;border-radius:0 8px 8px 0;background:#fff;color:#3730a3">Projection <%= pyr["year"] %></button>
            </div>
          <% end %>
        </div>
        <%= indicator_notes("population_structure__pyramide_des_ages", years: [latest]) %>
        <div data-pyr-mode="france">
          <p class="text-xs text-gray-500 mb-4">Part de chaque tranche d'âge de 5 ans dans la population totale, en %. Contour : <%= france ? france[:name] : "référence" %>. Une barre qui dépasse le contour signale une tranche surreprésentée.</p>
          <%= age_pyramid_chart(commune, france, latest, pyr_groups, labels["pyramid"] || {}) %>
        </div>
        <% if pyr %>
          <div data-pyr-mode="projection" style="display:none">
            <p class="text-xs text-gray-500 mb-4">Barres : population <%= latest %> (recensement). Contour : population projetée en <%= pyr["year"] %> (scénario tendanciel : natalité et migrations récentes de <%= la_commune %> reconduites, mortalité nationale), en % de la population totale de chaque année. Une barre qui dépasse le contour signale une tranche dont le poids diminuera ; un contour qui dépasse la barre, une tranche dont le poids augmentera. Population projetée : <%= fmt_count(ptotal.round) %> habitants en <%= pyr["year"] %>. Détail des projections dans les onglets Petite enfance, Enfance-jeunesse et Seniors.</p>
            <%= chart_canvas(pconfig, 480, "Pyramide des âges #{latest} et projection #{pyr['year']}") %>
          </div>
        <% end %>
        <%= indicator_source_note %>
      </section>
    <% end %>

    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Population par grande tranche d'âge (<%= latest %>)</h3>
      <%= indicator_notes("population_structure__population_par_grande_tranche_d_age", years: [latest]) do %>En %.<% end %>
      <%= comparison_stacked_chart(territories, latest, [
            ["age_lt15_percentage", "Moins de 15 ans", "#93c5fd"],
            ["age_15_24_percentage", "15-24 ans", "#3b82f6"],
            ["age_25_39_percentage", "25-39 ans", "#1d4ed8"],
            ["age_40_54_percentage", "40-54 ans", "#312e81"],
            ["age_55_64_percentage", "55-64 ans", "#fde68a"],
            ["age_65_79_percentage", "65-79 ans", "#f59e0b"],
            ["age_ge80_percentage", "80 ans ou plus", "#b45309"]
          ], "Population par grande tranche d'âge et par territoire") %>
      <%= indicator_source_note %>
    </section>
    <p class="text-xs text-gray-500" style="margin:-1.5rem 0 2rem">Le détail par âge est dans les onglets thématiques : <button type="button" data-action="click->dashboard-tabs#showTab" data-tab="children_comparison" style="color:#4f46e5">Petite enfance</button>, <button type="button" data-action="click->dashboard-tabs#showTab" data-tab="youth" style="color:#4f46e5">Enfance, jeunesse</button> (part des 15-24 ans, enfance et jeunesse par tranche d'âge, cartes IRIS) et <button type="button" data-action="click->dashboard-tabs#showTab" data-tab="seniors" style="color:#4f46e5">Seniors</button> (indice de vieillissement, repères sur le vieillissement, cartes IRIS).</p>
    <%= render "dashboard/map_group", maps: [
      { kind: :iris, map: cached_iris_map("age_25_39_share"),
        definition: "Personnes de 25 à 39 ans, en % de la population de l'IRIS : classes d'âge souvent associées à la parentalité." }
    ] %>


    <%= render "dashboard/territory_indicator", **common,
          title: "Rapport de dépendance", theme: "purple",
          value_key: "dependency_ratio", value_format: :decimal, unit: "", decimals: 1,
          definition: "Nombre de jeunes (moins de 20 ans) et de seniors (65 ans ou plus) pour 100 personnes de 20 à 64 ans. Plus il est élevé, plus la population d'âge actif est faible au regard des âges qui ont le plus besoin de services (petite enfance, école, accompagnement du vieillissement)." %>

    <%= render "dashboard/iris_map", map: cached_iris_map("dependency_ratio"), collapsed: true,
          definition: "Jeunes de moins de 20 ans et seniors de 65 ans ou plus pour 100 personnes de 20 à 64 ans, dans chaque IRIS (recensement 2023). Même définition que pour la commune." %>

    <div class="pt-4 border-t border-gray-200 text-xs text-gray-500 space-y-1">
      <p>Source : INSEE, recensements de la population 1968 à <%= latest %> (géographie au 1er janvier 2026) ; pyramide des âges <%= latest %> ; projection : calcul par cohortes (détail dans les onglets Petite enfance, Enfance-jeunesse et Seniors). Évolutions en points de pourcentage entre <%= comparison %> et <%= latest %>. <span style="color:#d97706">⚠</span> Effectif inférieur à 200 : à interpréter avec prudence.</p>
    </div>
  <% end %>

  <%= story_card("q-population-4", 4, "Qui arrive dans la commune ?",
        "Lieu de résidence des habitants un an auparavant (personnes d'un an ou plus) et âge des nouveaux arrivants.") do %>
    <%= render "dashboard/territory_indicator", **common,
          title: "Nouveaux arrivants", theme: "teal",
          value_key: "newcomers_percentage",
          count_key: "mig_other_commune", total_key: "mig_total", count_label: "habitants",
          definition: "Part des habitants qui résidaient dans une autre commune (ou à l'étranger) un an auparavant. Repère de l'attractivité et des besoins d'accueil (inscriptions scolaires, accès aux droits, lien social).",
          details: [
            { label: "Venus de l'étranger", share_key: "from_abroad_percentage" },
            { label: "Ont déménagé dans la commune", share_key: "moved_within_commune_percentage" },
            { label: "Même logement qu'un an avant", share_key: "same_dwelling_percentage" }
          ] %>

    <section style="margin-bottom:2.5rem">
      <h3 class="text-sm font-medium text-gray-700 mb-1">Âge des nouveaux arrivants (<%= latest %>)</h3>
      <%= indicator_notes("population_structure__age_des_nouveaux_arrivants", years: [latest]) do %>Répartition par âge des habitants arrivés d'une autre commune dans l'année, en %.<% end %>
      <%= comparison_grouped_bar_chart(territories, latest,
            (labels["newcomer_ages"] || {}).map { |k, l| ["newcomers_#{k}_percentage", l] },
            "Âge des nouveaux arrivants par territoire") %>
      <%= indicator_source_note %>
    </section>

    <div class="pt-4 border-t border-gray-200 text-xs text-gray-500 space-y-1">
      <p>Source : INSEE, recensements de la population 1968 à <%= latest %> (géographie au 1er janvier 2026). Évolutions en points de pourcentage entre <%= comparison %> et <%= latest %>. <span style="color:#d97706">⚠</span> Effectif inférieur à 200 : à interpréter avec prudence.</p>
    </div>
  <% end %>

<% end %>
