<%# E-mail de bienvenue (création d'un compte par l'administrateur) : styles en ligne, mise en page en tableaux
    (compatibilité des messageries), couleurs du site (indigo #4f46e5, gris ardoise) %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f1f5f9;padding:32px 12px;font-family:Inter,'Segoe UI',Helvetica,Arial,sans-serif;color:#111827">
  <tr>
    <td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background:#ffffff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden">
        <!-- En-tête -->
        <tr>
          <td style="padding:22px 32px;border-bottom:1px solid #eef2f7">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="width:36px;height:36px;background:#4f46e5;border-radius:8px;text-align:center;vertical-align:middle;color:#ffffff;font-size:18px;font-weight:700;line-height:36px">&#8599;</td>
                <td style="padding-left:12px">
                  <div style="font-size:16px;font-weight:700;color:#0f172a;line-height:1.2">Observatoire social de territoire</div>
                  <div style="font-size:12px;color:#6b7280;line-height:1.4">réalisé par Copas</div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Message -->
        <tr>
          <td style="padding:32px 32px 8px">
            <h1 style="margin:0 0 16px;font-size:24px;line-height:1.25;font-weight:700;color:#0f172a">Bienvenue sur l'Observatoire social de territoire</h1>
            <p style="margin:0 0 14px;font-size:15px;line-height:1.6;color:#374151">Bonjour,</p>
            <p style="margin:0 0 14px;font-size:15px;line-height:1.6;color:#374151">Un compte a été créé pour <strong style="color:#111827"><%= @territory_label %></strong>. Vous y trouverez le tableau de bord de votre territoire : plus de 160 indicateurs (population, familles, logement, emploi, revenus, accès aux droits, santé…), comparés à l'intercommunalité, au département, à la région et à la France, avec des cartes par quartier.</p>
          </td>
        </tr>

        <!-- Identifiants -->
        <tr>
          <td style="padding:8px 32px">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px">
              <tr>
                <td style="padding:18px 20px">
                  <div style="font-size:12px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:#4338ca;margin-bottom:10px">Vos identifiants</div>
                  <div style="font-size:14px;color:#4b5563;margin-bottom:6px">Adresse e-mail : <strong style="color:#111827"><%= @user.email %></strong></div>
                  <div style="font-size:14px;color:#4b5563">Mot de passe temporaire : <strong style="font-family:Menlo,Consolas,monospace;font-size:15px;color:#111827;background:#ffffff;border:1px solid #e2e8f0;border-radius:6px;padding:2px 8px"><%= @temporary_password %></strong></div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Bouton -->
        <tr>
          <td style="padding:24px 32px 8px" align="left">
            <a href="<%= @login_url %>" style="display:inline-block;background:#4f46e5;color:#ffffff;text-decoration:none;font-weight:600;font-size:15px;padding:13px 24px;border-radius:8px">Se connecter</a>
          </td>
        </tr>

        <!-- Mot de passe -->
        <tr>
          <td style="padding:16px 32px 28px">
            <p style="margin:0;font-size:13px;line-height:1.6;color:#4b5563">À votre première connexion, vous choisirez votre propre mot de passe : au moins 12 caractères, avec une minuscule, une majuscule, un chiffre et un caractère spécial (@$!%*?&amp;).</p>
          </td>
        </tr>

        <!-- Signature -->
        <tr>
          <td style="padding:20px 32px 28px;border-top:1px solid #eef2f7">
            <p style="margin:0 0 6px;font-size:14px;line-height:1.6;color:#374151">Une question ? Écrivez-nous à <a href="mailto:<%= contact_email %>" style="color:#4338ca"><%= contact_email %></a>.</p>
            <p style="margin:0;font-size:14px;line-height:1.6;color:#374151">À bientôt sur l'Observatoire,<br>L'équipe Copas</p>
          </td>
        </tr>
      </table>

      <!-- Pied -->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px">
        <tr>
          <td style="padding:16px 32px;font-size:12px;line-height:1.6;color:#6b7280;text-align:center">
            L'Observatoire social de territoire est réalisé par <a href="https://www.copas.coop/" style="color:#4b5563">Copas</a>, coopérative qui accompagne les collectivités depuis plus de 40 ans.<br>
            Cet e-mail a été envoyé automatiquement, merci de ne pas y répondre.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
