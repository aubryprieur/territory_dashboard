<div style="font-family: Arial, Helvetica, sans-serif; color: #111827; max-width: 640px">
  <p style="margin: 0 0 16px; font-size: 16px; font-weight: bold">Nouveau message depuis le formulaire de contact de l'Observatoire social de territoire</p>
  <table cellpadding="6" cellspacing="0" style="border-collapse: collapse; font-size: 14px">
    <tr><td style="color: #6b7280">Objet</td><td><strong><%= @contact.subject_label %></strong></td></tr>
    <tr><td style="color: #6b7280">Nom</td><td><%= @contact.name %></td></tr>
    <tr><td style="color: #6b7280">Organisation</td><td><%= @contact.organization %></td></tr>
    <tr><td style="color: #6b7280">E-mail</td><td><a href="mailto:<%= @contact.email %>"><%= @contact.email %></a></td></tr>
    <tr><td style="color: #6b7280">Téléphone</td><td><%= @contact.phone.presence || "non renseigné" %></td></tr>
    <tr><td style="color: #6b7280">Territoire concerné</td><td><%= @contact.territory.presence || "non renseigné" %></td></tr>
  </table>
  <p style="margin: 20px 0 6px; font-size: 14px; color: #6b7280">Message</p>
  <div style="font-size: 14px; line-height: 1.6; white-space: pre-wrap; border-left: 3px solid #c7d2fe; padding-left: 12px"><%= @contact.message %></div>
  <p style="margin: 24px 0 0; font-size: 12px; color: #6b7280">Répondre à cet e-mail écrit directement à <%= @contact.email %>.</p>
</div>
