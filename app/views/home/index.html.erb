<%#
  Page d'accueil publique : l'observatoire social de territoire (chiffres de l'outil, avant / après, fonctionnalités,
  thématiques, publics, tarif sur demande). Les enquêtes sont mises de côté.
  Captures (app/assets/images/accueil/) : apercu_carte.jpg (haut de page), apercu_indicateur.jpg (« Avec l'outil »),
  apercu_carte_tableau.jpg (carte et classement des quartiers).
%>
<% content_for :full_width, true %>
<%
  files = ["Recensement – population", "Recensement – logement", "Filosofi – revenus", "CAF – prestations", "France Travail – DEFM", "RPLS – parc social", "BPE – équipements", "Contours IRIS"]
  features = [
    ["Organisé en questions", "Chaque thématique se lit comme un chapitre de diagnostic : quelles familles vivent ici ? qui vit seul ? les habitants accèdent-ils à leurs droits ?"],
    ["Comparé à 5 échelles", "Chaque indicateur est situé par rapport à l'intercommunalité, au département, à la région et à la France, avec son évolution."],
    ["Cartographié par quartier", "Les cartes par IRIS révèlent les écarts entre quartiers que la moyenne communale masque."],
    ["Synthèse des enjeux", "Le rang du territoire parmi les communes de même densité situe l'intensité de chaque enjeu."],
    ["Définition, intérêt, source", "Chaque indicateur est défini, commenté pour l'analyse sociale et sourcé avec son millésime."],
    ["Export image et Excel", "Chaque graphique et chaque carte s'enregistre en image, avec son titre, sa légende et sa source ; les données de chaque bloc se téléchargent en Excel. Prêts pour vos rapports et présentations."]
  ]
  themes = ["Population", "Ménages", "Familles", "Logement", "Petite enfance", "Enfance et jeunesse", "Scolarité", "Diplômes et formation", "Emploi", "Tissu économique", "Revenus et pauvreté", "Immigrés et étrangers", "Accès aux droits", "Santé", "Seniors", "Handicap", "Équipements et services", "Vie locale", "Délinquance"]
%>
<div style="font-family: Inter, system-ui, -apple-system, 'Segoe UI', sans-serif; color: #111827; background: #ffffff; width: 100%">
  <!-- Hero -->
  <section id="top" style="background: #f8fafc; border-bottom: 1px solid #eef2f7">
    <div style="max-width: 1200px; margin: 0 auto; padding: 72px 24px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center">
      <div style="flex: 1 1 440px; min-width: 0">
        <h1 style="margin: 0; font-size: 48px; line-height: 1.08; font-weight: 700; color: #0f172a">Votre observatoire social de territoire, prêt à l'emploi</h1>
        <p style="margin: 20px 0 0; font-size: 19px; line-height: 1.55; color: #374151">Plus de 160 indicateurs issus des principales sources publiques, déjà mis en forme en graphiques, tableaux et cartes par quartier, pour chaque commune et chaque intercommunalité de France.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px">
          <a href="#contact" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 8px; background: #4f46e5; color: #ffffff; text-decoration: none; font-weight: 600">Demander une présentation</a>
          <a href="#outil" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 8px; border: 1px solid #cbd5e1; color: #1f2937; text-decoration: none; font-weight: 600; background: #ffffff">Découvrir l'outil</a>
        </div>
        <p style="margin: 20px 0 0; font-size: 14px; color: #4b5563">Un observatoire réalisé par <a href="https://www.copas.coop/" target="_blank" rel="noopener" style="color: #3730a3; font-weight: 600">Copas</a>, coopérative qui accompagne les collectivités depuis plus de 40 ans.</p>
      </div>

      <!-- Aperçu : carte du taux de pauvreté par quartier (capture du tableau de bord de Lille) -->
      <div style="flex: 1 1 520px; min-width: 0">
        <figure style="margin: 0">
          <%= image_tag "accueil/apercu_carte.jpg", alt: "Carte du taux de pauvreté par quartier (IRIS) à Lille, extraite du tableau de bord", style: "width: 100%; height: auto; display: block; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 12px 32px rgba(15,23,42,0.08); background: #ffffff" %>
          <figcaption style="margin-top: 10px; font-size: 13px; color: #4b5563">Le taux de pauvreté par quartier à Lille, tel qu'il apparaît dans le tableau de bord.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Chiffres clés de l'outil -->
  <section style="border-bottom: 1px solid #eef2f7">
    <div style="max-width: 1200px; margin: 0 auto; padding: 40px 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px">
      <div><p style="margin: 0; font-size: 40px; font-weight: 700; color: #4338ca">160+</p><p style="margin: 4px 0 0; color: #374151">indicateurs définis, sourcés et commentés</p></div>
      <div><p style="margin: 0; font-size: 40px; font-weight: 700; color: #4338ca">19</p><p style="margin: 4px 0 0; color: #374151">thématiques, organisées en questions</p></div>
      <div><p style="margin: 0; font-size: 40px; font-weight: 700; color: #4338ca">5</p><p style="margin: 4px 0 0; color: #374151">échelles comparées : commune, EPCI, département, région, France</p></div>
      <div><p style="margin: 0; font-size: 40px; font-weight: 700; color: #4338ca">60+</p><p style="margin: 4px 0 0; color: #374151">indicateurs cartographiés par quartier (IRIS)</p></div>
    </div>
  </section>

  <!-- Avant / après -->
  <section id="outil" style="background: #ffffff">
    <div style="max-width: 1200px; margin: 0 auto; padding: 80px 24px">
      <h2 style="margin: 0; font-size: 36px; font-weight: 700; color: #0f172a; max-width: 760px">Des dizaines de fichiers à croiser, ou un tableau de bord déjà prêt</h2>
      <p style="margin: 14px 0 0; font-size: 18px; line-height: 1.55; color: #374151; max-width: 760px">Un diagnostic social demande d'ordinaire des jours de téléchargement, de nettoyage et de mise en forme. L'outil fait ce travail en amont : vous partez directement de l'analyse.</p>

      <div style="display: flex; flex-wrap: wrap; gap: 24px; margin-top: 40px; align-items: stretch">
        <div style="flex: 1 1 420px; min-width: 0; border: 1px solid #e5e7eb; border-radius: 14px; padding: 24px; background: #f9fafb">
          <p style="margin: 0 0 16px; font-size: 13px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #6b7280">Sans l'outil</p>
          <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px">
            <% files.each do |f| %>
              <div style="display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 8px; background: #ffffff; border: 1px solid #e5e7eb; font-size: 13px; color: #374151; min-width: 0">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6"></path><path d="M8 13l4 4M12 13l-4 4"></path></svg>
                <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap"><%= f %></span>
              </div>
            <% end %>
          </div>
          <ul style="margin: 20px 0 0; padding-left: 18px; color: #4b5563; font-size: 15px; line-height: 1.7">
            <li>Télécharger les bases, retrouver les bons millésimes</li>
            <li>Isoler sa commune, son EPCI et les territoires de comparaison</li>
            <li>Calculer les taux, construire graphiques et cartes</li>
          </ul>
        </div>

        <div style="flex: 0 0 auto; display: flex; align-items: center; justify-content: center; padding: 0 4px">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
        </div>

        <div style="flex: 1 1 420px; min-width: 0; border: 1px solid #c7d2fe; border-radius: 14px; padding: 24px; background: #eef2ff">
          <p style="margin: 0 0 16px; font-size: 13px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #3730a3">Avec l'outil</p>
          <%= image_tag "accueil/apercu_indicateur.jpg", alt: "Bloc indicateur « Familles monoparentales » à Lille : chiffre clé et comparaison avec la métropole, le département, la région et la France", style: "width: 100%; height: auto; display: block; border-radius: 10px; border: 1px solid #e0e7ff; background: #ffffff" %>
          <ul style="margin: 20px 0 0; padding-left: 18px; color: #312e81; font-size: 15px; line-height: 1.7">
            <li>Les indicateurs à jour, comparés aux autres échelles</li>
            <li>Graphiques, tableaux et cartes déjà mis en forme</li>
            <li>Graphiques et cartes en image, données en Excel, pour vos rapports</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Aperçu : carte par quartier et classement des IRIS -->
  <section style="background: #ffffff">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px 80px">
      <h2 style="margin: 0; font-size: 28px; font-weight: 700; color: #0f172a">Chaque indicateur, quartier par quartier</h2>
      <p style="margin: 10px 0 24px; font-size: 17px; line-height: 1.55; color: #374151; max-width: 760px">La carte situe chaque quartier par rapport à la commune ; le tableau fait ressortir ceux où l'enjeu est le plus et le moins marqué, avec leur évolution.</p>
      <%# Capture présentée dans une fenêtre de navigateur, à la largeur du texte %>
      <div style="border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden; background: #ffffff; box-shadow: 0 12px 32px rgba(15,23,42,0.08)">
        <div style="display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-bottom: 1px solid #eef2f7; background: #f8fafc">
          <span style="width: 10px; height: 10px; border-radius: 99px; background: #e2e8f0"></span>
          <span style="width: 10px; height: 10px; border-radius: 99px; background: #e2e8f0"></span>
          <span style="width: 10px; height: 10px; border-radius: 99px; background: #e2e8f0"></span>
          <span style="margin-left: 10px; font-size: 12px; color: #6b7280">Tableau de bord · Lille · Familles</span>
        </div>
        <div style="padding: 24px 16px">
          <%= image_tag "accueil/apercu_carte_tableau.jpg", alt: "Carte de la part des familles monoparentales par quartier à Lille, avec le tableau des quartiers les plus et les moins concernés", style: "width: 100%; max-width: 880px; height: auto; display: block; margin: 0 auto" %>
        </div>
      </div>
    </div>
  </section>

  <!-- Fonctionnalités -->
  <section style="background: #f8fafc; border-top: 1px solid #eef2f7; border-bottom: 1px solid #eef2f7">
    <div style="max-width: 1200px; margin: 0 auto; padding: 80px 24px">
      <h2 style="margin: 0; font-size: 36px; font-weight: 700; color: #0f172a">Pensé pour le diagnostic, pas seulement pour la donnée</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 36px">
        <% features.each do |ft_title, ft_text| %>
          <div style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 22px">
            <h3 style="margin: 0; font-size: 17px; font-weight: 600; color: #111827"><%= ft_title %></h3>
            <p style="margin: 8px 0 0; font-size: 15px; line-height: 1.55; color: #4b5563"><%= ft_text %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Thématiques -->
  <section id="thematiques" style="background: #ffffff">
    <div style="max-width: 1200px; margin: 0 auto; padding: 80px 24px">
      <h2 style="margin: 0; font-size: 36px; font-weight: 700; color: #0f172a">19 thématiques, de la petite enfance au grand âge</h2>
      <p style="margin: 14px 0 0; font-size: 18px; line-height: 1.55; color: #374151; max-width: 760px">Chaque thématique répond à quelques questions simples, puis une synthèse situe l'intensité de chaque enjeu par rapport aux territoires comparables.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; margin-top: 32px">
        <% themes.each do |t| %>
          <div style="padding: 14px 16px; border-radius: 10px; border: 1px solid #e5e7eb; font-size: 15px; font-weight: 500; color: #1f2937"><%= t %></div>
        <% end %>
      </div>
      <p style="margin: 28px 0 0; font-size: 14px; line-height: 1.6; color: #4b5563">Sources : INSEE (recensements, Filosofi, état civil, BPE, Flores), Cnaf, France Travail, Assurance maladie, Observatoire des fragilités, SDES (RPLS, Sitadel), SSMSI, Éducation nationale, Annuaire de l'administration.</p>
    </div>
  </section>

  <!-- Pour qui -->
  <section id="pour-qui" style="background: #f8fafc; border-top: 1px solid #eef2f7; border-bottom: 1px solid #eef2f7">
    <div style="max-width: 1200px; margin: 0 auto; padding: 80px 24px">
      <h2 style="margin: 0; font-size: 36px; font-weight: 700; color: #0f172a">Pour celles et ceux qui préparent les politiques sociales</h2>
      <p style="margin: 14px 0 0; font-size: 18px; line-height: 1.55; color: #374151; max-width: 760px">Pour les communes et les intercommunalités (EPCI) : chaque commune de France et chaque EPCI dispose de son tableau de bord, comparé aux territoires qui l'entourent.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-top: 36px">
        <div style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 26px">
          <h3 style="margin: 0; font-size: 20px; font-weight: 600; color: #111827">CCAS et CIAS</h3>
          <p style="margin: 10px 0 0; font-size: 15px; line-height: 1.6; color: #4b5563">Réaliser l'analyse des besoins sociaux obligatoire et la mettre à jour chaque année, sans repartir de zéro. Les données sont prêtes ; vous consacrez votre temps aux entretiens, aux partenaires et au plan d'action.</p>
        </div>
        <div style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 26px">
          <h3 style="margin: 0; font-size: 20px; font-weight: 600; color: #111827">Chargés de mission</h3>
          <p style="margin: 10px 0 0; font-size: 15px; line-height: 1.6; color: #4b5563">Documenter un contrat de ville, une convention territoriale globale avec la CAF, un projet éducatif ou un schéma petite enfance : chiffres, cartes par quartier et sources citables en quelques clics.</p>
        </div>
        <div style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 26px">
          <h3 style="margin: 0; font-size: 20px; font-weight: 600; color: #111827">Intercommunalités</h3>
          <p style="margin: 10px 0 0; font-size: 15px; line-height: 1.6; color: #4b5563">Comparer les communes membres sur chaque indicateur, repérer celles où l'enjeu se concentre et ouvrir le tableau de bord de chacune d'elles.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Réalisé par Copas -->
  <section id="copas" style="background: #ffffff; border-bottom: 1px solid #eef2f7">
    <div style="max-width: 1200px; margin: 0 auto; padding: 72px 24px; display: flex; flex-wrap: wrap; gap: 40px; align-items: center">
      <div style="flex: 0 0 auto">
        <%= image_tag "accueil/copas_logo.jpg", alt: "Copas — Conseil en Pratiques & Analyses Sociales", style: "width: 220px; height: auto; display: block" %>
      </div>
      <div style="flex: 1 1 520px; min-width: 0">
        <h2 style="margin: 0; font-size: 32px; font-weight: 700; color: #0f172a">Un observatoire conçu par Copas</h2>
        <p style="margin: 14px 0 0; font-size: 18px; line-height: 1.55; color: #374151">L'observatoire est réalisé par Copas, Conseil en Pratiques &amp; Analyses Sociales, une coopérative qui accompagne les collectivités depuis plus de 40 ans. Il rassemble les données et les questions que nos consultants mobilisent dans leurs diagnostics de territoire et leurs analyses des besoins sociaux.</p>
        <p style="margin: 18px 0 0"><a href="https://www.copas.coop/" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: #3730a3">Découvrir Copas →</a></p>
      </div>
    </div>
  </section>

  <!-- Tarif et contact -->
  <section id="tarif" style="background: #ffffff">
    <div id="contact" style="max-width: 1200px; margin: 0 auto; padding: 80px 24px; display: flex; flex-wrap: wrap; gap: 40px; align-items: center; justify-content: space-between">
      <div style="flex: 1 1 520px; min-width: 0">
        <h2 style="margin: 0; font-size: 36px; font-weight: 700; color: #0f172a">Tarif sur demande</h2>
        <p style="margin: 14px 0 0; font-size: 18px; line-height: 1.55; color: #374151">L'abonnement dépend de la taille du territoire (commune ou intercommunalité). Contactez-nous pour une présentation de l'outil sur votre territoire et un devis.</p>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 12px">
        <a href="mailto:<%= contact_email %>" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 8px; background: #4f46e5; color: #ffffff; text-decoration: none; font-weight: 600">Nous contacter</a>
      </div>
    </div>
  </section>
</div>
